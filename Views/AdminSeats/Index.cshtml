@model IEnumerable<GoBus.Models.Trip>

@{
    ViewData["Title"] = "Quản lý Ghế/Giường";
}

<style>
    .admin-page {
        padding: 30px 0 60px;
    }

    .page-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
    }

    .table {
        margin-bottom: 0;
    }

    .table td {
        vertical-align: middle;
    }

    .badge-layout {
        padding: 7px 10px;
        border-radius: 8px;
        font-size: 12px;
    }

    .action-button {
        min-width: 95px;
    }

    .seat-count {
        font-weight: 700;
    }

    @@media (max-width: 768px) {
        .admin-page {
            padding: 20px 10px 40px;
        }
    }
</style>

<div class="container-fluid admin-page">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                💺 Quản lý Ghế/Giường
            </h2>

            <p class="text-muted mb-0">
                Quản lý sơ đồ ghế và giường theo từng chuyến xe.
            </p>

        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Dashboard
        </a>

    </div>


    <!-- THÔNG BÁO -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- TÌM KIẾM -->

    <div class="card page-card mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-6">

                        <label class="form-label fw-semibold">
                            Tìm kiếm
                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Điểm đi, điểm đến, nhà xe, biển số..." />

                    </div>


                    <div class="col-lg-3">

                        <label class="form-label fw-semibold">
                            Ngày khởi hành
                        </label>

                        <input type="date"
                               name="date"
                               value="@ViewBag.Date"
                               class="form-control" />

                    </div>


                    <div class="col-lg-3">

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary flex-grow-1">
                                🔍 Tìm kiếm
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Xóa
                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- DANH SÁCH -->

    <div class="card page-card">

        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-bold mb-0">
                    Danh sách chuyến xe
                </h5>

                <span class="text-muted">
                    @Model.Count() chuyến
                </span>

            </div>


            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                Tuyến
                            </th>

                            <th>
                                Nhà xe
                            </th>

                            <th>
                                Xe
                            </th>

                            <th>
                                Khởi hành
                            </th>

                            <th>
                                Loại
                            </th>

                            <th>
                                Tổng
                            </th>

                            <th>
                                Đã đặt
                            </th>

                            <th>
                                Còn trống
                            </th>

                            <th>
                                Thao tác
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (!Model.Any())
                        {
                            <tr>

                                <td colspan="10"
                                    class="text-center text-muted py-5">

                                    Không tìm thấy chuyến xe.

                                </td>

                            </tr>
                        }
                        else
                        {
                            foreach (var trip in Model)
                            {
                                var isSleeper =
                                    trip.Bus?.LayoutType == "Sleeper24";

                                var total =
                                    trip.Seats.Count;

                                var booked =
                                    trip.Seats.Count(s => s.IsBooked);

                                var available =
                                    total - booked;

                                <tr>

                                    <td>
                                        @trip.Id
                                    </td>


                                    <td>

                                        @if (trip.Route != null)
                                        {
                                            <strong>
                                                @trip.Route.Departure
                                            </strong>

                                            <span>
                                                →
                                            </span>

                                            <strong>
                                                @trip.Route.Destination
                                            </strong>
                                        }

                                    </td>


                                    <td>

                                        @trip.BusCompany?.Name

                                    </td>


                                    <td>

                                        @trip.Bus?.LicensePlate

                                        <div class="small text-muted">
                                            @trip.Bus?.BusType
                                        </div>

                                    </td>


                                    <td>

                                        @trip.DepartureTime
                                            .ToString("dd/MM/yyyy HH:mm")

                                    </td>


                                    <td>

                                        @if (isSleeper)
                                        {
                                            <span class="badge bg-info badge-layout">
                                                🛏️ Giường 24
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary badge-layout">
                                                💺 Ghế 45
                                            </span>
                                        }

                                    </td>


                                    <td class="seat-count">

                                        @total

                                    </td>


                                    <td>

                                        <span class="badge bg-danger">
                                            @booked
                                        </span>

                                    </td>


                                    <td>

                                        <span class="badge bg-success">
                                            @available
                                        </span>

                                    </td>


                                    <td>

                                        <a asp-action="Details"
                                           asp-route-tripId="@trip.Id"
                                           class="btn btn-sm btn-primary action-button">

                                            Xem sơ đồ

                                        </a>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>