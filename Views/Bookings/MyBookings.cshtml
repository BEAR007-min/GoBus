@model List<GoBus.Models.Booking>

@{
    ViewData["Title"] = "Vé đã đặt";
}

<div class="container py-5">

    <div class="text-center mb-4">
        <h1 class="fw-bold">🎫 Vé đã đặt</h1>
        <p class="text-muted">
            Tra cứu các vé bạn đã đặt trên GoBus
        </p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="MyBookings"
                  method="get"
                  class="row g-3">

                <div class="col-md-10">
                    <label class="form-label fw-semibold">
                        Số điện thoại
                    </label>

                    <input type="text"
                           name="phone"
                           value="@ViewBag.Phone"
                           class="form-control"
                           placeholder="Nhập số điện thoại đã đặt vé..." />
                </div>

                <div class="col-md-2 d-flex align-items-end">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Tra cứu
                    </button>
                </div>

            </form>

        </div>
    </div>

    @if (ViewBag.Phone != null && Model.Count == 0)
    {
        <div class="alert alert-warning">
            Không tìm thấy vé nào với số điện thoại
            <strong>@ViewBag.Phone</strong>.
        </div>
    }

    @foreach (var booking in Model)
    {
        <div class="card shadow-sm mb-4">

            <div class="card-header d-flex justify-content-between align-items-center">

                <div>
                    <strong>
                        Mã đặt vé #@booking.Id
                    </strong>

                    <span class="badge bg-success ms-2">
                        @booking.Status
                    </span>
                </div>

                <small class="text-muted">
                    @booking.BookingDate.ToString("dd/MM/yyyy HH:mm")
                </small>

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-8">

                        <h5 class="fw-bold">
                            @booking.Trip?.Route?.Departure
                            →
                            @booking.Trip?.Route?.Destination
                        </h5>

                        <p class="mb-1">
                            🚌
                            <strong>Nhà xe:</strong>
                            @booking.Trip?.BusCompany?.Name
                        </p>

                        <p class="mb-1">
                            🕐
                            <strong>Khởi hành:</strong>
                            @booking.Trip?.DepartureTime.ToString("dd/MM/yyyy HH:mm")
                        </p>

                        <p class="mb-1">
                            👤
                            <strong>Khách hàng:</strong>
                            @booking.Customer?.FullName
                        </p>

                        <p class="mb-1">
                            📞
                            <strong>Số điện thoại:</strong>
                            @booking.Customer?.Phone
                        </p>

                        <p class="mb-1">
                            💺
                            <strong>Ghế:</strong>

                            @foreach (var detail in booking.BookingDetails)
                            {
                                <span class="badge bg-primary me-1">
                                    @detail.Seat?.SeatNumber
                                </span>
                            }
                        </p>

                    </div>

                    <div class="col-md-4 text-md-end mt-3 mt-md-0">

                        <p class="text-muted mb-1">
                            Tổng tiền
                        </p>

                        <h4 class="text-danger fw-bold">
                            @booking.TotalAmount.ToString("N0") ₫
                        </h4>
                    @if (booking.Status != "Cancelled")
                {
                    <form asp-action="Cancel"
                        method="post"
                        class="mt-3"
                        onsubmit="return confirm('Bạn có chắc chắn muốn hủy vé này không?');">

                        <input type="hidden"
                            name="id"
                            value="@booking.Id" />

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger">
                            Hủy vé
                        </button>

                    </form>
                }
                else
                {
                    <div class="alert alert-secondary mt-3 mb-0">
                        Vé đã được hủy.
                    </div>
                }
                    </div>

                </div>

            </div>

        </div>
    }

</div>