@model GoBus.ViewModels.BookingCreateViewModel

@{
    var trip = ViewBag.Trip as GoBus.Models.Trip;
    var seats = ViewBag.Seats as List<GoBus.Models.Seat>
                ?? new List<GoBus.Models.Seat>();

    var totalAmount = seats.Count * (trip?.Price ?? 0);
}

<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Đặt vé - GoBus</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>

        body {
            background: #f5f7fa;
        }

        .booking-page {
            max-width: 1000px;
            margin: 40px auto;
        }

        .card-custom {
            background: white;
            border-radius: 16px;
            padding: 25px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            margin-bottom: 20px;
        }

        .seat-badge {
            display: inline-block;
            background: #0d6efd;
            color: white;
            padding: 8px 14px;
            border-radius: 8px;
            margin: 4px;
            font-weight: bold;
        }

        .total {
            font-size: 28px;
            font-weight: bold;
            color: #0d6efd;
        }

    </style>

</head>

<body>

<div class="container booking-page">

    <h1 class="mb-4">
        Xác nhận đặt vé
    </h1>


    <!-- THÔNG TIN CHUYẾN -->
    <div class="card-custom">

        <h3>
            @trip?.Route?.Departure
            →
            @trip?.Route?.Destination
        </h3>

        <hr />

        <p>
            <strong>Nhà xe:</strong>
            @trip?.BusCompany?.Name
        </p>

        <p>
            <strong>Xe:</strong>
            @trip?.Bus?.LicensePlate
        </p>

        <p>
            <strong>Khởi hành:</strong>
            @trip?.DepartureTime.ToString("dd/MM/yyyy HH:mm")
        </p>

        <p>
            <strong>Giá mỗi vé:</strong>
            @trip?.Price.ToString("N0") đ
        </p>

    </div>


    <!-- GHẾ -->
    <div class="card-custom">

        <h3 class="mb-3">
            Ghế đã chọn
        </h3>

        @foreach (var seat in seats)
        {
            <span class="seat-badge">
                @seat.SeatNumber
            </span>
        }

        <hr />

        <p class="mb-1">
            Số lượng:
            <strong>@seats.Count ghế</strong>
        </p>

        <p class="mb-0">
            Tổng tiền:
        </p>

        <div class="total">
            @totalAmount.ToString("N0") đ
        </div>

    </div>


    <!-- THÔNG TIN KHÁCH HÀNG -->
    <div class="card-custom">

        <h3 class="mb-4">
            Thông tin khách hàng
        </h3>


        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()


            <input type="hidden"
                   asp-for="TripId" />


            @foreach (var seatId in Model.SeatIds)
            {
                <input type="hidden"
                       name="SeatIds"
                       value="@seatId" />
            }


            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger">
            </div>


            <div class="card mb-4">
            <div class="card-body">

                <h5 class="fw-bold mb-3">
                    Thông tin khách hàng
                </h5>

                <p class="mb-2">
                    <strong>Họ tên:</strong>
                    @User.Identity?.Name
                </p>

                <p class="text-muted mb-0">
                    Thông tin khách hàng được lấy từ tài khoản đang đăng nhập.
                </p>

            </div>
        </div>


            <div class="d-flex gap-2">

                <a href="javascript:history.back()"
                   class="btn btn-secondary">

                    Quay lại

                </a>


                <button type="submit"
                        class="btn btn-primary flex-grow-1">

                    Xác nhận đặt vé

                </button>

            </div>

        </form>

    </div>

</div>

</body>

</html>