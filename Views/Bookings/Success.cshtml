@model GoBus.Models.Booking

<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Đặt vé thành công - GoBus</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>

        body {
            background: #f5f7fa;
        }

        .success-page {
            max-width: 800px;
            margin: 60px auto;
        }

        .success-card {
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
        }

        .success-icon {
            font-size: 70px;
        }

        .ticket {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 20px;
            margin-top: 25px;
        }

        .seat {
            display: inline-block;
            background: #0d6efd;
            color: white;
            padding: 8px 15px;
            border-radius: 8px;
            margin: 3px;
        }

        .price {
            color: #0d6efd;
            font-size: 28px;
            font-weight: bold;
        }

    </style>

</head>

<body>

<div class="container success-page">

    <div class="success-card text-center">

        <div class="success-icon">
            ✅
        </div>

        <h1 class="text-success">
            Đặt vé thành công!
        </h1>

        <p class="text-muted">
            Cảm ơn bạn đã sử dụng dịch vụ GoBus.
        </p>


        <div class="ticket text-start">

            <h4 class="mb-4">
                Thông tin vé
            </h4>

            <p>
                <strong>Mã đặt vé:</strong>
                #@Model.Id
            </p>

            <p>
                <strong>Khách hàng:</strong>
                @Model.Customer?.FullName
            </p>

            <p>
                <strong>Số điện thoại:</strong>
                @Model.Customer?.Phone
            </p>

            <hr />

            <p>
                <strong>Tuyến:</strong>

                @Model.Trip?.Route?.Departure
                →
                @Model.Trip?.Route?.Destination
            </p>

            <p>
                <strong>Nhà xe:</strong>
                @Model.Trip?.BusCompany?.Name
            </p>

            <p>
                <strong>Khởi hành:</strong>
                @Model.Trip?.DepartureTime.ToString("dd/MM/yyyy HH:mm")
            </p>

            <p>
                <strong>Ghế:</strong>
            </p>

            @foreach (var detail in Model.BookingDetails)
            {
                <span class="seat">
                    @detail.Seat?.SeatNumber
                </span>
            }

            <hr />

            <p class="mb-1">
                Tổng tiền:
            </p>

            <div class="price">
                @Model.TotalAmount.ToString("N0") đ
            </div>

        </div>


        <div class="mt-4">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-primary">

                Về trang chủ

            </a>

        </div>

    </div>

</div>

</body>

</html>