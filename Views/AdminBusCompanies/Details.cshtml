@model GoBus.Models.BusCompany

@{
    ViewData["Title"] = "Chi tiết nhà xe";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h1 class="fw-bold">
                🏢 @Model.Name
            </h1>

            <p class="text-muted mb-0">
                Thông tin chi tiết nhà xe #@Model.Id
            </p>

        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-dark">
                ✏️ Sửa
            </a>

            <a asp-action="Index"
               class="btn btn-light">
                ← Quay lại
            </a>

        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-4">
                        Thông tin nhà xe
                    </h4>

                    <div class="row g-4">

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Tên nhà xe
                            </div>

                            <div class="fw-bold">
                                @Model.Name
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Số điện thoại
                            </div>

                            <div class="fw-bold">
                                @Model.Phone
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Email
                            </div>

                            <div class="fw-bold">
                                @Model.Email
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="text-muted small">
                                Địa chỉ
                            </div>

                            <div class="fw-bold">
                                @Model.Address
                            </div>

                        </div>

                        <div class="col-12">

                            <div class="text-muted small">
                                Mô tả
                            </div>

                            <div class="mt-1">
                                @(string.IsNullOrWhiteSpace(Model.Description)
                                    ? "Chưa có mô tả."
                                    : Model.Description)
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm rounded-4 mb-4">

                <div class="card-body p-4">

                    <h5 class="fw-bold">
                        🚍 Xe
                    </h5>

                    <div class="display-6 fw-bold">
                        @Model.Buses.Count
                    </div>

                    <div class="text-muted">
                        xe thuộc nhà xe này
                    </div>

                </div>

            </div>

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <h5 class="fw-bold">
                        🛣️ Chuyến
                    </h5>

                    <div class="display-6 fw-bold">
                        @Model.Trips.Count
                    </div>

                    <div class="text-muted">
                        chuyến thuộc nhà xe này
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>