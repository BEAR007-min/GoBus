@model GoBus.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .admin-page {
        padding: 30px 0 60px;
    }

    .dashboard-header {
        margin-bottom: 30px;
    }

    .dashboard-header h2 {
        font-weight: 700;
        margin-bottom: 6px;
    }

    .dashboard-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    /* =========================
       STAT CARDS
       ========================= */

    .stat-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
        height: 100%;
        transition: all 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .stat-title {
        color: #6c757d;
        margin-top: 15px;
        font-size: 14px;
    }

    .stat-number {
        font-size: 28px;
        font-weight: 700;
        margin-top: 5px;
    }

    /* =========================
       MANAGEMENT
       ========================= */

    .section-title {
        font-weight: 700;
        margin-bottom: 20px;
    }

    .management-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 24px;
        height: 100%;
        border: 1px solid #eef0f2;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
        transition: all 0.2s ease;
    }

    .management-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
    }

    .management-icon {
        width: 58px;
        height: 58px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        background: #f1f3f5;
        margin-bottom: 18px;
    }

    .management-card h5 {
        font-weight: 700;
        margin-bottom: 8px;
    }

    .management-card p {
        color: #6c757d;
        min-height: 48px;
        margin-bottom: 18px;
        font-size: 14px;
    }

    .management-button {
        display: inline-block;
        width: 100%;
        text-align: center;
        padding: 10px 15px;
        border-radius: 10px;
        background: #0d6efd;
        color: #ffffff;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .management-button:hover {
        background: #0b5ed7;
        color: #ffffff;
    }

    /* =========================
       REVENUE
       ========================= */

    .revenue-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
        height: 100%;
    }

    .revenue-value {
        font-size: 30px;
        font-weight: 700;
    }

    .revenue-label {
        color: #6c757d;
        font-size: 14px;
    }

    /* =========================
       BOOKING STATUS
       ========================= */

    .status-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
    }

    .status-number {
        font-size: 26px;
        font-weight: 700;
    }

    .status-item {
        padding: 15px;
        border-radius: 12px;
        background: #f8f9fa;
    }

    /* =========================
       QUICK ACTION
       ========================= */

    .quick-action {
        border-radius: 15px;
        padding: 18px;
        background: #f8f9fa;
        text-decoration: none;
        color: #212529;
        display: block;
        transition: all 0.2s ease;
    }

    .quick-action:hover {
        background: #e9ecef;
        color: #212529;
        transform: translateY(-2px);
    }

    .quick-icon {
        font-size: 25px;
        margin-right: 10px;
    }

    @@media (max-width: 768px) {
        .admin-page {
            padding: 20px 10px 40px;
        }

        .stat-number {
            font-size: 24px;
        }

        .revenue-value {
            font-size: 25px;
        }
    }
</style>


<div class="container-fluid admin-page">

    <!-- =====================================
         HEADER
         ===================================== -->

    <div class="dashboard-header">

        <h2>
            🛠️ Admin Dashboard
        </h2>

        <p>
            Quản lý và theo dõi toàn bộ hệ thống GoBus.
        </p>

    </div>


    <!-- =====================================
         THÔNG BÁO
         ===================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- =====================================
         THỐNG KÊ TỔNG QUAN
         ===================================== -->

    <h4 class="section-title">
        📊 Tổng quan hệ thống
    </h4>

    <div class="row g-4 mb-5">

        <!-- KHÁCH HÀNG -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-primary-subtle">
                        👥
                    </div>

                    <div class="stat-title">
                        Khách hàng
                    </div>

                    <div class="stat-number text-primary">
                        @Model.TotalCustomers
                    </div>

                </div>

            </div>

        </div>


        <!-- TÀI KHOẢN -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-secondary-subtle">
                        👤
                    </div>

                    <div class="stat-title">
                        Tài khoản
                    </div>

                    <div class="stat-number">
                        @Model.TotalUsers
                    </div>

                </div>

            </div>

        </div>


        <!-- NHÀ XE -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-success-subtle">
                        🏢
                    </div>

                    <div class="stat-title">
                        Nhà xe
                    </div>

                    <div class="stat-number text-success">
                        @Model.TotalBusCompanies
                    </div>

                </div>

            </div>

        </div>


        <!-- XE -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-info-subtle">
                        🚌
                    </div>

                    <div class="stat-title">
                        Xe
                    </div>

                    <div class="stat-number text-info">
                        @Model.TotalBuses
                    </div>

                </div>

            </div>

        </div>


        <!-- TUYẾN -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-warning-subtle">
                        🛣️
                    </div>

                    <div class="stat-title">
                        Tuyến
                    </div>

                    <div class="stat-number text-warning">
                        @Model.TotalRoutes
                    </div>

                </div>

            </div>

        </div>


        <!-- CHUYẾN -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-primary-subtle">
                        🚍
                    </div>

                    <div class="stat-title">
                        Chuyến
                    </div>

                    <div class="stat-number text-primary">
                        @Model.TotalTrips
                    </div>

                </div>

            </div>

        </div>


        <!-- TỔNG VÉ -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-danger-subtle">
                        🎫
                    </div>

                    <div class="stat-title">
                        Tổng vé
                    </div>

                    <div class="stat-number text-danger">
                        @Model.TotalBookings
                    </div>

                </div>

            </div>

        </div>


        <!-- CHUYẾN HÔM NAY -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-success-subtle">
                        📅
                    </div>

                    <div class="stat-title">
                        Chuyến hôm nay
                    </div>

                    <div class="stat-number text-success">
                        @Model.TodayTrips
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================
         DOANH THU
         ===================================== -->

    <h4 class="section-title">
        💰 Doanh thu
    </h4>

    <div class="row g-4 mb-5">

        <!-- TỔNG DOANH THU -->

        <div class="col-lg-4">

            <div class="card revenue-card">

                <div class="card-body">

                    <div class="revenue-label">
                        Tổng doanh thu
                    </div>

                    <div class="revenue-value text-primary">
                        @Model.TotalRevenue.ToString("N0") ₫
                    </div>

                </div>

            </div>

        </div>


        <!-- DOANH THU XÁC NHẬN -->

        <div class="col-lg-4">

            <div class="card revenue-card">

                <div class="card-body">

                    <div class="revenue-label">
                        Doanh thu đã xác nhận
                    </div>

                    <div class="revenue-value text-success">
                        @Model.ConfirmedRevenue.ToString("N0") ₫
                    </div>

                </div>

            </div>

        </div>


        <!-- DOANH THU HÔM NAY -->

        <div class="col-lg-4">

            <div class="card revenue-card">

                <div class="card-body">

                    <div class="revenue-label">
                        Vé đã xác nhận
                    </div>

                    <div class="revenue-value text-success">
                        @Model.ConfirmedBookings
                    </div>

                    <div class="small text-muted mt-2">
                        Vé đã hủy:
                        @Model.CancelledBookings
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================
         QUẢN LÝ HỆ THỐNG
         ===================================== -->

    <h4 class="section-title">
        ⚙️ Quản lý hệ thống
    </h4>

    <div class="row g-4 mb-5">

        <!-- NHÀ XE -->

        <div class="col-xl-3 col-md-6">

            <div class="management-card">

                <div class="management-icon">
                    🏢
                </div>

                <h5>
                    Quản lý Nhà xe
                </h5>

                <p>
                    Thêm, sửa, xóa và xem thông tin
                    các nhà xe trong hệ thống.
                </p>

                <a asp-controller="AdminBusCompanies"
                   asp-action="Index"
                   class="management-button">
                    Quản lý
                </a>

            </div>

        </div>


        <!-- XE -->

        <div class="col-xl-3 col-md-6">

            <div class="management-card">

                <div class="management-icon">
                    🚌
                </div>

                <h5>
                    Quản lý Xe
                </h5>

                <p>
                    Quản lý xe, biển số, loại xe,
                    ghế ngồi và giường nằm.
                </p>

                <a asp-controller="AdminBuses"
                   asp-action="Index"
                   class="management-button">
                    Quản lý
                </a>

            </div>

        </div>


        <!-- TUYẾN -->

        <div class="col-xl-3 col-md-6">

            <div class="management-card">

                <div class="management-icon">
                    🛣️
                </div>

                <h5>
                    Quản lý Tuyến
                </h5>

                <p>
                    Quản lý điểm đi, điểm đến,
                    khoảng cách và thời gian.
                </p>

                <a asp-controller="AdminRoutes"
                   asp-action="Index"
                   class="management-button">
                    Quản lý
                </a>

            </div>

        </div>


        <!-- CHUYẾN -->

        <div class="col-xl-3 col-md-6">

            <div class="management-card">

                <div class="management-icon">
                    🚍
                </div>

                <h5>
                    Quản lý Chuyến
                </h5>

                <p>
                    Quản lý lịch chạy, xe,
                    tuyến và giá vé.
                </p>

                <a asp-controller="AdminTrips"
                   asp-action="Index"
                   class="management-button">
                    Quản lý
                </a>

            </div>

        </div>


        <!-- GHẾ / GIƯỜNG -->

        <div class="col-xl-3 col-md-6">

            <div class="management-card">

                <div class="management-icon">
                    💺
                </div>

                <h5>
                    Quản lý Ghế/Giường
                </h5>

                <p>
                    Xem sơ đồ ghế, giường,
                    ghế trống và ghế đã đặt.
                </p>

                <a asp-controller="AdminSeats"
                   asp-action="Index"
                   class="management-button">
                    Quản lý
                </a>

            </div>

        </div>


        <!-- VÉ -->

        <div class="col-xl-3 col-md-6">

            <div class="management-card">

                <div class="management-icon">
                    🎫
                </div>

                <h5>
                    Quản lý Vé
                </h5>

                <p>
                    Xem danh sách vé,
                    thông tin đặt vé và trạng thái.
                </p>

                <a asp-controller="AdminBookings"
                   asp-action="Index"
                   class="management-button">
                    Quản lý
                </a>

            </div>

        </div>


        <!-- KHÁCH HÀNG -->

        <div class="col-xl-3 col-md-6">

            <div class="management-card">

                <div class="management-icon">
                    👥
                </div>

                <h5>
                    Quản lý Khách hàng
                </h5>

                <p>
                    Xem, sửa và quản lý thông tin
                    khách hàng và lịch sử đặt vé.
                </p>

                <a asp-controller="AdminCustomers"
                   asp-action="Index"
                   class="management-button">
                    Quản lý
                </a>

            </div>

        </div>


        <!-- THỐNG KÊ -->

        <div class="col-xl-3 col-md-6">

            <div class="management-card">

                <div class="management-icon">
                    📊
                </div>

                <h5>
                    Thống kê
                </h5>

                <p>
                    Xem doanh thu, số vé,
                    tuyến xe và hoạt động hệ thống.
                </p>

                <a asp-controller="AdminStatistics"
                   asp-action="Index"
                   class="management-button">
                    Xem thống kê
                </a>

            </div>

        </div>

    </div>


    <!-- =====================================
         TRẠNG THÁI VÉ
         ===================================== -->

    <h4 class="section-title">
        🎫 Trạng thái vé
    </h4>

    <div class="row g-4 mb-5">

        <!-- XÁC NHẬN -->

        <div class="col-md-6">

            <div class="card status-card">

                <div class="card-body">

                    <div class="status-item">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="text-muted">
                                    Vé đã xác nhận
                                </div>

                                <div class="status-number text-success">
                                    @Model.ConfirmedBookings
                                </div>

                            </div>

                            <div style="font-size: 35px;">
                                ✅
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- HỦY -->

        <div class="col-md-6">

            <div class="card status-card">

                <div class="card-body">

                    <div class="status-item">

                        <div class="d-flex justify-content-between align-items-center">

                            <div>

                                <div class="text-muted">
                                    Vé đã hủy
                                </div>

                                <div class="status-number text-danger">
                                    @Model.CancelledBookings
                                </div>

                            </div>

                            <div style="font-size: 35px;">
                                ❌
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================
         THAO TÁC NHANH
         ===================================== -->

    <h4 class="section-title">
        ⚡ Thao tác nhanh
    </h4>

    <div class="row g-3">

        <div class="col-md-3">

            <a asp-controller="AdminBusCompanies"
               asp-action="Create"
               class="quick-action">

                <span class="quick-icon">
                    ➕
                </span>

                Thêm nhà xe

            </a>

        </div>


        <div class="col-md-3">

            <a asp-controller="AdminBuses"
               asp-action="Create"
               class="quick-action">

                <span class="quick-icon">
                    🚌
                </span>

                Thêm xe

            </a>

        </div>


        <div class="col-md-3">

            <a asp-controller="AdminRoutes"
               asp-action="Create"
               class="quick-action">

                <span class="quick-icon">
                    🛣️
                </span>

                Thêm tuyến

            </a>

        </div>


        <div class="col-md-3">

            <a asp-controller="AdminTrips"
               asp-action="Create"
               class="quick-action">

                <span class="quick-icon">
                    🚍
                </span>

                Thêm chuyến

            </a>

        </div>

    </div>

</div>