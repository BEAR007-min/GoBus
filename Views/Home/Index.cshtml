    </div>

</div>



<!-- ============================= -->
<!-- JAVASCRIPT NGÀY -->
<!-- ============================= -->

<script>

    const dateDisplay =
        document.getElementById("dateDisplay");

    const hiddenDate =
        document.getElementById("date");

    const searchForm =
        document.getElementById("searchForm");


    // ==========================================
    // Tự động thêm dấu /
    // ==========================================

    dateDisplay.addEventListener("input", function () {

        let value =
            this.value.replace(/\D/g, "");

        if (value.length > 8) {
            value = value.substring(0, 8);
        }


        if (value.length >= 5) {

            value =
                value.substring(0, 2)
                + "/"
                + value.substring(2, 4)
                + "/"
                + value.substring(4);

        }
        else if (value.length >= 3) {

            value =
                value.substring(0, 2)
                + "/"
                + value.substring(2);

        }


        this.value = value;

    });


    // ==========================================
    // Kiểm tra ngày
    // ==========================================

    searchForm.addEventListener("submit", function (event) {

        const value =
            dateDisplay.value.trim();


        // Không nhập ngày
        if (value === "") {

            hiddenDate.value = "";

            return;
        }


        // Kiểm tra định dạng DD/MM/YYYY
        const regex =
            /^(\d{2})\/(\d{2})\/(\d{4})$/;


        const match =
            value.match(regex);


        if (!match) {

            event.preventDefault();

            dateDisplay.focus();

            return;
        }


        const day =
            parseInt(match[1]);

        const month =
            parseInt(match[2]);

        const year =
            parseInt(match[3]);


        // Kiểm tra tháng
        if (month < 1 || month > 12) {

            event.preventDefault();

            alert("Tháng không hợp lệ.");

            dateDisplay.focus();

            return;
        }


        // Kiểm tra ngày thực tế
        const testDate =
            new Date(
                year,
                month - 1,
                day
            );


        if (
            testDate.getFullYear() !== year ||
            testDate.getMonth() !== month - 1 ||
            testDate.getDate() !== day
        ) {

            event.preventDefault();

            alert("Ngày không hợp lệ.");

            dateDisplay.focus();

            return;
        }


        // ======================================
        // Chuyển DD/MM/YYYY
        // thành YYYY-MM-DD
        // ======================================

        hiddenDate.value =
            year
            + "-"
            + String(month).padStart(2, "0")
            + "-"
            + String(day).padStart(2, "0");

    });

</script>