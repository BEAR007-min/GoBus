<!-- ============================= -->
<!-- JAVASCRIPT -->
<!-- ============================= -->

<script>

    const dateDisplay =
        document.getElementById("dateDisplay");

    const hiddenDate =
        document.getElementById("date");

    const searchForm =
        document.getElementById("searchForm");

    const departure =
        document.getElementById("departure");

    const destination =
        document.getElementById("destination");


    // ==========================================
    // TỰ ĐỘNG THÊM DẤU /
    // ==========================================

    dateDisplay.addEventListener("input", function () {

        let value =
            this.value.replace(/\D/g, "");

        if (value.length > 8) {

            value =
                value.substring(0, 8);

        }


        if (value.length >= 5) {

            value =
                value.substring(0, 2)
                + "/"
                + value.substring(2, 4)
                + "/"
                + value.substring(4);

        }
        else if (value.length >= 3) {

            value =
                value.substring(0, 2)
                + "/"
                + value.substring(2);

        }


        this.value = value;

    });


    // ==========================================
    // FORM SUBMIT
    // ==========================================

    searchForm.addEventListener(
        "submit",
        function (event) {

            // ------------------------------
            // KIỂM TRA ĐIỂM ĐI
            // ------------------------------

            if (departure.value === "") {

                event.preventDefault();

                alert("Vui lòng chọn điểm đi.");

                departure.focus();

                return;

            }


            // ------------------------------
            // KIỂM TRA ĐIỂM ĐẾN
            // ------------------------------

            if (destination.value === "") {

                event.preventDefault();

                alert("Vui lòng chọn điểm đến.");

                destination.focus();

                return;

            }


            // ------------------------------
            // KHÔNG CHO CÙNG ĐIỂM
            // ------------------------------

            if (
                departure.value !== "" &&
                destination.value !== "" &&
                departure.value === destination.value
            ) {

                event.preventDefault();

                alert(
                    "Điểm đi và điểm đến không được giống nhau."
                );

                destination.focus();

                return;

            }


            // ------------------------------
            // NGÀY
            // ------------------------------

            const value =
                dateDisplay.value.trim();


            // Không nhập ngày
            if (value === "") {

                hiddenDate.value = "";

                return;

            }


            // ------------------------------
            // KIỂM TRA DD/MM/YYYY
            // ------------------------------

            const regex =
                /^(\d{2})\/(\d{2})\/(\d{4})$/;

            const match =
                value.match(regex);


            if (!match) {

                event.preventDefault();

                alert(
                    "Vui lòng nhập ngày theo định dạng DD/MM/YYYY."
                );

                dateDisplay.focus();

                return;

            }


            const day =
                parseInt(match[1], 10);

            const month =
                parseInt(match[2], 10);

            const year =
                parseInt(match[3], 10);


            // ------------------------------
            // KIỂM TRA THÁNG
            // ------------------------------

            if (
                month < 1 ||
                month > 12
            ) {

                event.preventDefault();

                alert("Tháng không hợp lệ.");

                dateDisplay.focus();

                return;

            }


            // ------------------------------
            // KIỂM TRA NGÀY
            // ------------------------------

            const testDate =
                new Date(
                    year,
                    month - 1,
                    day
                );


            if (
                testDate.getFullYear() !== year ||
                testDate.getMonth() !== month - 1 ||
                testDate.getDate() !== day
            ) {

                event.preventDefault();

                alert("Ngày không hợp lệ.");

                dateDisplay.focus();

                return;

            }


            // ------------------------------
            // CHUYỂN SANG YYYY-MM-DD
            // ------------------------------

            hiddenDate.value =
                year
                + "-"
                + String(month).padStart(2, "0")
                + "-"
                + String(day).padStart(2, "0");

        }
    );

</script>