                    const date = document.getElementById("date");

                    // Ngày hiện tại
                    const today = new Date();

                    // YYYY-MM-DD theo giờ địa phương
                    const year = today.getFullYear();
                    const month = String(today.getMonth() + 1).padStart(2, "0");
                    const day = String(today.getDate()).padStart(2, "0");

                    const todayString = `${year}-${month}-${day}`;

                    // Không cho chọn ngày hôm qua trở về trước
                    dateDisplay.min = todayString;

                    // Mặc định chọn hôm nay
                    dateDisplay.value = todayString;
                    date.value = todayString;

                    // Khi người dùng chọn ngày
                    dateDisplay.addEventListener("change", function () {

                        if (this.value < todayString) {
                            alert("Ngày đi không được ở trong quá khứ.");

                            this.value = todayString;
                            date.value = todayString;

                            return;
                        }

                        date.value = this.value;
                    });
                });
            </script>

