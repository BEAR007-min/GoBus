@model IEnumerable<GoBus.Models.Trip>

@{
    ViewData["Title"] = "Quản lý chuyến xe";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Quản lý chuyến xe</h2>
            <p class="text-muted mb-0">
                Quản lý lịch trình và thông tin các chuyến xe
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Thêm chuyến xe
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bộ lọc -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Tìm kiếm
                    </label>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Tuyến đường, nhà xe, biển số..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        Ngày khởi hành
                    </label>

                    <input type="date"
                           name="date"
                           value="@(ViewBag.Date != null
                               ? ((DateTime)ViewBag.Date).ToString("yyyy-MM-dd")
                               : "")"
                           class="form-control" />
                </div>

                <div class="col-md-3 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary flex-fill">
                        🔍 Tìm kiếm
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Xóa
                    </a>

                </div>

            </form>

        </div>
    </div>

    <!-- Danh sách -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">
                Danh sách chuyến xe
            </h5>
        </div>

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <div style="font-size: 50px;">
                        🚌
                    </div>

                    <h5 class="mt-3">
                        Không tìm thấy chuyến xe
                    </h5>

                    <p class="text-muted">
                        Hãy thử thay đổi điều kiện tìm kiếm.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>#</th>

                                <th>Tuyến đường</th>

                                <th>Nhà xe</th>

                                <th>Xe</th>

                                <th>Khởi hành</th>

                                <th>Đến nơi</th>

                                <th>Giá vé</th>

                                <th>Còn lại</th>

                                <th class="text-center">
                                    Thao tác
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                        @{
                            int stt = 1;
                        }

                        @foreach (var trip in Model)
                        {
                            <tr>

                                <td>
                                    @stt
                                </td>

                                <td>
                                    @if (trip.Route != null)
                                    {
                                        <div class="fw-semibold">
                                            @trip.Route.Departure
                                        </div>

                                        <div class="text-muted small">
                                            ↓ @trip.Route.Destination
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Chưa có tuyến
                                        </span>
                                    }
                                </td>

                                <td>
                                    @trip.BusCompany?.Name
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @trip.Bus?.LicensePlate
                                    </div>

                                    <div class="text-muted small">
                                        @trip.Bus?.BusType
                                    </div>
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @trip.DepartureTime.ToString("dd/MM/yyyy")
                                    </div>

                                    <div class="text-muted small">
                                        @trip.DepartureTime.ToString("HH:mm")
                                    </div>
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @trip.ArrivalTime.ToString("dd/MM/yyyy")
                                    </div>

                                    <div class="text-muted small">
                                        @trip.ArrivalTime.ToString("HH:mm")
                                    </div>
                                </td>

                                <td>
                                    <span class="fw-bold text-danger">
                                        @trip.Price.ToString("N0") đ
                                    </span>
                                </td>

                                <td>

                                    @if (trip.AvailableSeats > 0)
                                    {
                                        <span class="badge bg-success">
                                            @trip.AvailableSeats chỗ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Hết chỗ
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="d-flex justify-content-center gap-1">

                                        <a asp-action="Details"
                                           asp-route-id="@trip.Id"
                                           class="btn btn-sm btn-outline-info"
                                           title="Chi tiết">
                                            👁
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@trip.Id"
                                           class="btn btn-sm btn-outline-warning"
                                           title="Chỉnh sửa">
                                            ✏️
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@trip.Id"
                                              method="post"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa chuyến xe này không?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Xóa">
                                                🗑
                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                            stt++;
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

    <div class="mt-3">
        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Quay lại Dashboard
        </a>
    </div>

</div>