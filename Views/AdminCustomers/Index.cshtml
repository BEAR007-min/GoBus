@model IEnumerable<GoBus.Models.Customer>

@{
    ViewData["Title"] = "Quản lý Khách hàng";
}

<style>
    .customer-page {
        padding: 30px 0 50px;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .page-header h2 {
        font-weight: 700;
        margin-bottom: 5px;
    }

    .page-header p {
        color: #6c757d;
        margin-bottom: 0;
    }

    .filter-card,
    .table-card {
        border: none;
        border-radius: 16px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.07);
    }

    .table td {
        vertical-align: middle;
    }

    .customer-name {
        font-weight: 600;
    }

    .customer-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #e7f1ff;
        font-size: 20px;
        margin-right: 10px;
    }

    .booking-count {
        font-weight: 700;
    }

    @@media (max-width: 768px) {
        .customer-page {
            padding: 20px 10px 40px;
        }
    }
</style>

<div class="container-fluid customer-page">

    <!-- HEADER -->

    <div class="page-header">

        <h2>
            👥 Quản lý Khách hàng
        </h2>

        <p>
            Quản lý thông tin khách hàng và lịch sử đặt vé.
        </p>

    </div>


    <!-- THÔNG BÁO -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- TÌM KIẾM -->

    <div class="card filter-card mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-9">

                        <label class="form-label fw-semibold">
                            Tìm kiếm khách hàng
                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Họ tên, số điện thoại hoặc email..." />

                    </div>

                    <div class="col-md-3 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-fill">
                            🔍 Tìm kiếm
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Xóa
                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- DANH SÁCH -->

    <div class="card table-card">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="fw-bold mb-0">
                    Danh sách khách hàng
                </h5>

                <span class="badge bg-primary">
                    @Model.Count() khách hàng
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <div style="font-size: 50px;">
                        👥
                    </div>

                    <h5 class="mt-3">
                        Không tìm thấy khách hàng
                    </h5>

                    <p class="text-muted">
                        Chưa có khách hàng phù hợp với điều kiện tìm kiếm.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    #
                                </th>

                                <th>
                                    Khách hàng
                                </th>

                                <th>
                                    Số điện thoại
                                </th>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Số vé
                                </th>

                                <th>
                                    Vé đã xác nhận
                                </th>

                                <th class="text-center">
                                    Thao tác
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @{
                                int stt = 1;
                            }

                            @foreach (var customer in Model)
                            {
                                var totalBookings =
                                    customer.Bookings.Count;

                                var confirmedBookings =
                                    customer.Bookings.Count(
                                        b => b.Status == "Confirmed");

                                <tr>

                                    <td>
                                        @stt
                                    </td>


                                    <!-- KHÁCH HÀNG -->

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="customer-avatar">
                                                👤
                                            </div>

                                            <div>

                                                <div class="customer-name">
                                                    @customer.FullName
                                                </div>

                                                <div class="small text-muted">
                                                    ID: @customer.Id
                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- SĐT -->

                                    <td>
                                        @customer.Phone
                                    </td>


                                    <!-- EMAIL -->

                                    <td>
                                        @customer.Email
                                    </td>


                                    <!-- TỔNG VÉ -->

                                    <td>

                                        <span class="booking-count">
                                            @totalBookings
                                        </span>

                                    </td>


                                    <!-- VÉ XÁC NHẬN -->

                                    <td>

                                        @if (confirmedBookings > 0)
                                        {
                                            <span class="badge bg-success">
                                                @confirmedBookings
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                0
                                            </span>
                                        }

                                    </td>


                                    <!-- THAO TÁC -->

                                    <td>

                                        <div class="d-flex justify-content-center gap-2">

                                            <a asp-action="Details"
                                               asp-route-id="@customer.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                👁 Xem
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@customer.Id"
                                               class="btn btn-sm btn-outline-warning">
                                                ✏️ Sửa
                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                stt++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- QUAY LẠI -->

    <div class="mt-3">

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Quay lại Dashboard
        </a>

    </div>

</div>