@model IEnumerable<GoBus.Models.Seat>

@{
    ViewData["Title"] = "Chọn ghế";

    var trip = ViewBag.Trip as GoBus.Models.Trip;
    var bus = trip?.Bus;

    string layoutType = bus?.LayoutType ?? "Seat45";
    bool isSleeper = layoutType == "Sleeper24";

    var seats = Model?.ToList() ?? new List<GoBus.Models.Seat>();

    var floorA = seats
        .Where(s => s.SeatNumber.StartsWith("A"))
        .OrderBy(s => s.SeatNumber)
        .ToList();

    var floorB = seats
        .Where(s => s.SeatNumber.StartsWith("B"))
        .OrderBy(s => s.SeatNumber)
        .ToList();

    decimal price = trip?.Price ?? 0;
}

<div class="seat-page">

    <!-- HEADER -->
    <div class="seat-header">

        <div>

            <div class="seat-header-badge">
                @(isSleeper ? "🛏️ XE GIƯỜNG NẰM" : "🚌 XE GHẾ NGỒI")
            </div>

            <h1>
                Chọn @(isSleeper ? "giường" : "ghế")
            </h1>

            @if (trip?.Route != null)
            {
                <p>
                    @trip.Route.Departure
                    <span class="route-arrow">→</span>
                    @trip.Route.Destination
                </p>
            }

        </div>

        <div class="seat-header-price">

            <span>Giá vé</span>

            <strong>
                @price.ToString("N0") đ
            </strong>

        </div>

    </div>


    <!-- THÔNG TIN CHUYẾN -->
    @if (trip != null)
    {
        <div class="trip-summary">

            <div class="trip-summary-item">

                <span class="summary-icon">
                    🏢
                </span>

                <div>

                    <small>
                        Nhà xe
                    </small>

                    <strong>
                        @trip.BusCompany?.Name
                    </strong>

                </div>

            </div>


            <div class="trip-summary-item">

                <span class="summary-icon">
                    🚌
                </span>

                <div>

                    <small>
                        Loại xe
                    </small>

                    <strong>
                        @(isSleeper
                            ? "Giường nằm 24 chỗ"
                            : "Ghế ngồi 45 chỗ")
                    </strong>

                </div>

            </div>


            <div class="trip-summary-item">

                <span class="summary-icon">
                    🕐
                </span>

                <div>

                    <small>
                        Khởi hành
                    </small>

                    <strong>
                        @trip.DepartureTime.ToString("HH:mm - dd/MM/yyyy")
                    </strong>

                </div>

            </div>


            <div class="trip-summary-item">

                <span class="summary-icon">
                    💺
                </span>

                <div>

                    <small>
                        Còn lại
                    </small>

                    <strong>
                        @trip.AvailableSeats chỗ
                    </strong>

                </div>

            </div>

        </div>
    }


    <!-- CHÚ THÍCH -->
    <div class="seat-legend">

        <div class="legend-item">

            <span class="legend-box available"></span>

            <span>
                Trống
            </span>

        </div>


        <div class="legend-item">

            <span class="legend-box selected"></span>

            <span>
                Đang chọn
            </span>

        </div>


        <div class="legend-item">

            <span class="legend-box booked"></span>

            <span>
                Đã đặt
            </span>

        </div>

    </div>


    <!-- XE -->
    <div class="bus-layout-wrapper">

        <div class="bus-layout">

            <!-- ĐẦU XE -->
            <div class="bus-front">

                <div class="driver-area">

                    <span class="steering-wheel">
                        ◉
                    </span>

                    <span>
                        Tài xế
                    </span>

                </div>

                <div class="bus-front-label">
                    ĐẦU XE
                </div>

            </div>
    

            @if (isSleeper)
            {
                <!-- ================================================= -->
                <!-- XE GIƯỜNG NẰM -->
                <!-- ================================================= -->

                <div class="floor-title">

                    <span>🛏️</span>

                    TẦNG DƯỚI

                </div>


                <div class="sleeper-floor">

                    @foreach (var seat in floorA)
                    {
                        var isBooked = seat.IsBooked;

                        <button type="button"
                                class="sleeper-bed @(isBooked ? "booked" : "")"
                                data-seat-id="@seat.Id"
                                data-seat-number="@seat.SeatNumber"
                                data-booked="@isBooked.ToString().ToLower()"
                                @(isBooked ? "disabled" : null)>

                            <span class="bed-number">
                                @seat.SeatNumber
                            </span>

                            <span class="bed-icon">
                                🛏️
                            </span>

                            <span class="bed-status">
                                @(isBooked ? "Đã đặt" : "Trống")
                            </span>

                        </button>
                    }

                </div>


                <div class="floor-title upper-floor-title">

                    <span>🛏️</span>

                    TẦNG TRÊN

                </div>


                <div class="sleeper-floor">

                    @foreach (var seat in floorB)
                    {
                        var isBooked = seat.IsBooked;

                        <button type="button"
                                class="sleeper-bed @(isBooked ? "booked" : "")"
                                data-seat-id="@seat.Id"
                                data-seat-number="@seat.SeatNumber"
                                data-booked="@isBooked.ToString().ToLower()"
                                @(isBooked ? "disabled" : null)>

                            <span class="bed-number">
                                @seat.SeatNumber
                            </span>

                            <span class="bed-icon">
                                🛏️
                            </span>

                            <span class="bed-status">
                                @(isBooked ? "Đã đặt" : "Trống")
                            </span>

                        </button>
                    }

                </div>
            }
            else
            {
                <!-- ================================================= -->
                <!-- XE GHẾ NGỒI 45 CHỖ -->
                <!-- ================================================= -->

                <div class="seat-bus-label">

                    <span>💺</span>

                    SƠ ĐỒ 45 GHẾ

                </div>


                <div class="seat-bus">

                    @{
                        int totalSeatCount = Math.Min(
                            bus?.TotalSeats ?? 45,
                            45
                        );
                    }


                    <!-- ============================================= -->
                    <!-- GHẾ 01 - 40 -->
                    <!-- 4 GHẾ / HÀNG -->
                    <!-- ============================================= -->

                    @for (int row = 0; row < 10; row++)
                    {
                        int startNumber = row * 4 + 1;

                        <div class="seat-row">

                            <!-- BÊN TRÁI -->

                            @for (int col = 0; col < 2; col++)
                            {
                                int currentNumber =
                                    startNumber + col;

                                if (currentNumber <= totalSeatCount)
                                {
                                    var seat = seats.FirstOrDefault(
                                        s => s.SeatNumber ==
                                             currentNumber.ToString("00")
                                    );

                                    if (seat != null)
                                    {
                                        var isBooked = seat.IsBooked;

                                        <button type="button"
                                                class="normal-seat @(isBooked ? "booked" : "")"
                                                data-seat-id="@seat.Id"
                                                data-seat-number="@seat.SeatNumber"
                                                data-booked="@isBooked.ToString().ToLower()"
                                                @(isBooked ? "disabled" : null)>

                                            <span class="seat-number">
                                                @seat.SeatNumber
                                            </span>

                                            <span class="seat-icon">
                                                💺
                                            </span>

                                        </button>
                                    }
                                }
                            }


                            <!-- LỐI ĐI -->

                            <div class="bus-aisle">
                                <span></span>
                            </div>


                            <!-- BÊN PHẢI -->

                            @for (int col = 0; col < 2; col++)
                            {
                                int currentNumber =
                                    startNumber + 2 + col;

                                if (currentNumber <= totalSeatCount)
                                {
                                    var seat = seats.FirstOrDefault(
                                        s => s.SeatNumber ==
                                             currentNumber.ToString("00")
                                    );

                                    if (seat != null)
                                    {
                                        var isBooked = seat.IsBooked;

                                        <button type="button"
                                                class="normal-seat @(isBooked ? "booked" : "")"
                                                data-seat-id="@seat.Id"
                                                data-seat-number="@seat.SeatNumber"
                                                data-booked="@isBooked.ToString().ToLower()"
                                                @(isBooked ? "disabled" : null)>

                                            <span class="seat-number">
                                                @seat.SeatNumber
                                            </span>

                                            <span class="seat-icon">
                                                💺
                                            </span>

                                        </button>
                                    }
                                }
                            }

                        </div>
                    }


                    <!-- ============================================= -->
                    <!-- GHẾ 41 - 45 -->
                    <!-- 5 GHẾ CÙNG MỘT HÀNG -->
                    <!-- ============================================= -->

                    @if (totalSeatCount >= 41)
                    {
                        <div class="last-seat-row">

                            @for (int number = 41;
                                  number <= 45;
                                  number++)
                            {
                                if (number <= totalSeatCount)
                                {
                                    var seat = seats.FirstOrDefault(
                                        s => s.SeatNumber ==
                                             number.ToString("00")
                                    );

                                    if (seat != null)
                                    {
                                        var isBooked = seat.IsBooked;

                                        <button type="button"
                                                class="normal-seat last-seat @(isBooked ? "booked" : "")"
                                                data-seat-id="@seat.Id"
                                                data-seat-number="@seat.SeatNumber"
                                                data-booked="@isBooked.ToString().ToLower()"
                                                @(isBooked ? "disabled" : null)>

                                            <span class="seat-number">
                                                @seat.SeatNumber
                                            </span>

                                            <span class="seat-icon">
                                                💺
                                            </span>

                                        </button>
                                    }
                                }
                            }

                        </div>
                    }

                </div>
            }


            <!-- CUỐI XE -->
            <div class="bus-back">

                <span>
                    CUỐI XE
                </span>

            </div>

        </div>

    </div>


    <!-- THANH ĐẶT VÉ -->
    <div class="booking-bar">

        <div class="booking-selected">

            <div class="booking-label">

                @(isSleeper
                    ? "Giường đã chọn"
                    : "Ghế đã chọn")

            </div>


            <div id="selectedSeats"
                 class="selected-seats">

                Chưa chọn
                @(isSleeper ? "giường" : "ghế")

            </div>

        </div>


        <div class="booking-info">

            <div class="booking-count">

                <span>
                    Số lượng
                </span>

                <strong id="selectedCount">
                    0
                </strong>

            </div>


            <div class="booking-total">

                <span>
                    Tổng tiền
                </span>

                <strong id="totalPrice">
                    0 đ
                </strong>

            </div>

        </div>


        <button type="button"
                id="continueButton"
                class="continue-button"
                disabled>

            Tiếp tục đặt vé

            <span>
                →
            </span>

        </button>

    </div>

</div>


<style>

/* ========================================================= */
/* PAGE */
/* ========================================================= */

.seat-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 35px 20px 120px;
}


/* ========================================================= */
/* HEADER */
/* ========================================================= */

.seat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
    margin-bottom: 25px;
}

.seat-header-badge {
    display: inline-block;
    background: #e8f1ff;
    color: #2563eb;
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
    margin-bottom: 10px;
}

.seat-header h1 {
    margin: 0;
    font-size: 32px;
    font-weight: 800;
    color: #172033;
}

.seat-header p {
    margin: 8px 0 0;
    color: #64748b;
    font-size: 16px;
}

.route-arrow {
    margin: 0 8px;
    color: #2563eb;
    font-weight: 800;
}

.seat-header-price {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    padding: 18px 25px;
    text-align: right;
    min-width: 180px;
}

.seat-header-price span {
    display: block;
    color: #64748b;
    font-size: 13px;
    margin-bottom: 5px;
}

.seat-header-price strong {
    font-size: 24px;
    color: #2563eb;
}


/* ========================================================= */
/* TRIP SUMMARY */
/* ========================================================= */

.trip-summary {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 15px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 18px;
    margin-bottom: 20px;
}

.trip-summary-item {
    display: flex;
    align-items: center;
    gap: 12px;
}

.summary-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #eff6ff;
    font-size: 20px;
    flex-shrink: 0;
}

.trip-summary-item small {
    display: block;
    color: #94a3b8;
    font-size: 12px;
    margin-bottom: 3px;
}

.trip-summary-item strong {
    display: block;
    color: #172033;
    font-size: 14px;
}


/* ========================================================= */
/* LEGEND */
/* ========================================================= */

.seat-legend {
    display: flex;
    justify-content: center;
    gap: 28px;
    margin: 25px 0;
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: #64748b;
    font-size: 14px;
}

.legend-box {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    display: inline-block;
    border: 1px solid #cbd5e1;
}

.legend-box.available {
    background: white;
}

.legend-box.selected {
    background: #2563eb;
    border-color: #2563eb;
}

.legend-box.booked {
    background: #e2e8f0;
    border-color: #cbd5e1;
}


/* ========================================================= */
/* BUS */
/* ========================================================= */

.bus-layout-wrapper {
    display: flex;
    justify-content: center;
}

.bus-layout {
    width: 600px;
    max-width: 100%;
    background: #f8fafc;
    border: 2px solid #cbd5e1;
    border-radius: 35px 35px 25px 25px;
    padding: 25px;
    box-shadow: 0 12px 35px rgba(15, 23, 42, 0.08);
}


/* ========================================================= */
/* FRONT */
/* ========================================================= */

.bus-front {
    height: 80px;
    border-bottom: 2px dashed #cbd5e1;
    margin-bottom: 25px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
}

.driver-area {
    position: absolute;
    left: 5px;
    top: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
}

.steering-wheel {
    font-size: 30px;
    margin-bottom: 2px;
}

.bus-front-label {
    color: #94a3b8;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
}


/* ========================================================= */
/* SLEEPER */
/* ========================================================= */

.floor-title {
    text-align: center;
    color: #172033;
    font-size: 15px;
    font-weight: 800;
    margin: 5px 0 15px;
}

.upper-floor-title {
    margin-top: 35px;
}

.sleeper-floor {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    padding: 0 20px;
}

.sleeper-bed {
    position: relative;
    min-height: 100px;
    border: 2px solid #dbe4ef;
    background: white;
    border-radius: 16px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    color: #172033;
}

.sleeper-bed:hover:not(:disabled) {
    border-color: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.12);
}

.sleeper-bed.selected {
    background: #2563eb;
    border-color: #2563eb;
    color: white;
    box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);
}

.sleeper-bed.booked {
    background: #e2e8f0;
    border-color: #cbd5e1;
    color: #94a3b8;
    cursor: not-allowed;
    opacity: 0.75;
}

.bed-number {
    font-size: 14px;
    font-weight: 900;
}

.bed-icon {
    font-size: 28px;
}

.bed-status {
    font-size: 11px;
    font-weight: 700;
}

.sleeper-bed.selected .bed-status {
    color: white;
}


/* ========================================================= */
/* NORMAL SEAT BUS */
/* ========================================================= */

.seat-bus-label {
    text-align: center;
    color: #172033;
    font-size: 15px;
    font-weight: 800;
    margin-bottom: 18px;
}

.seat-bus {
    width: 100%;
}


/* ========================================================= */
/* GHẾ 01 - 40 */
/* ========================================================= */

.seat-row {
    display: grid;
    grid-template-columns: 1fr 1fr 35px 1fr 1fr;
    gap: 10px;
    margin-bottom: 10px;
}


/* ========================================================= */
/* GHẾ 41 - 45 */
/* ========================================================= */

.last-seat-row {
    display: grid;

    /*
       5 ghế cùng một hàng.
       Hàng này nằm dưới ghế 01 - 40.
    */

    grid-template-columns:
        repeat(5, 1fr);

    gap: 10px;

    margin-top: 15px;
}

.last-seat-row .normal-seat {
    width: 100%;
}


/* ========================================================= */
/* AISLE */
/* ========================================================= */

.bus-aisle {
    display: flex;
    justify-content: center;
    align-items: center;
}

.bus-aisle span {
    width: 2px;
    height: 65%;
    background: #e2e8f0;
    border-radius: 2px;
}


/* ========================================================= */
/* NORMAL SEAT */
/* ========================================================= */

.normal-seat {
    height: 72px;
    border: 2px solid #dbe4ef;
    background: white;
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    color: #172033;
}

.normal-seat:hover:not(:disabled) {
    border-color: #2563eb;
    transform: translateY(-2px);
    box-shadow: 0 7px 18px rgba(37, 99, 235, 0.12);
}

.normal-seat.selected {
    background: #2563eb;
    border-color: #2563eb;
    color: white;
    box-shadow: 0 8px 18px rgba(37, 99, 235, 0.25);
}

.normal-seat.booked {
    background: #e2e8f0;
    border-color: #cbd5e1;
    color: #94a3b8;
    cursor: not-allowed;
    opacity: 0.7;
}

.seat-number {
    font-size: 13px;
    font-weight: 900;
}

.seat-icon {
    font-size: 22px;
}


/* ========================================================= */
/* BACK */
/* ========================================================= */

.bus-back {
    height: 55px;
    border-top: 2px dashed #cbd5e1;
    margin-top: 25px;
    display: flex;
    justify-content: center;
    align-items: end;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
}


/* ========================================================= */
/* BOOKING BAR */
/* ========================================================= */

.booking-bar {
    position: fixed;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    width: min(1100px, calc(100% - 30px));
    background: white;
    border: 1px solid #dbe4ef;
    border-radius: 20px;
    box-shadow: 0 15px 45px rgba(15, 23, 42, 0.16);
    padding: 15px 20px;
    display: flex;
    align-items: center;
    gap: 25px;
    z-index: 1000;
}

.booking-selected {
    flex: 1;
    min-width: 180px;
}

.booking-label {
    color: #64748b;
    font-size: 12px;
    margin-bottom: 5px;
}

.selected-seats {
    font-size: 15px;
    font-weight: 800;
    color: #172033;
    word-break: break-word;
}

.booking-info {
    display: flex;
    gap: 30px;
    align-items: center;
}

.booking-count span,
.booking-total span {
    display: block;
    color: #94a3b8;
    font-size: 11px;
    margin-bottom: 3px;
}

.booking-count strong {
    font-size: 20px;
    color: #172033;
}

.booking-total strong {
    font-size: 21px;
    color: #2563eb;
}

.continue-button {
    border: none;
    background: #2563eb;
    color: white;
    border-radius: 12px;
    padding: 14px 22px;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
}

.continue-button:hover:not(:disabled) {
    background: #1d4ed8;
    transform: translateY(-1px);
}

.continue-button:disabled {
    background: #cbd5e1;
    cursor: not-allowed;
}

.continue-button span {
    margin-left: 6px;
}


/* ========================================================= */
/* RESPONSIVE */
/* ========================================================= */

@@media (max-width: 900px) {

    .trip-summary {
        grid-template-columns: repeat(2, 1fr);
    }

    .booking-bar {
        flex-wrap: wrap;
    }

    .booking-selected {
        min-width: 45%;
    }

    .booking-info {
        margin-left: auto;
    }

    .continue-button {
        width: 100%;
    }

}


@@media (max-width: 600px) {

    .seat-page {
        padding: 20px 10px 180px;
    }

    .seat-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .seat-header-price {
        width: 100%;
        text-align: left;
    }

    .trip-summary {
        grid-template-columns: 1fr;
    }

    .seat-legend {
        gap: 12px;
        flex-wrap: wrap;
    }

    .bus-layout {
        padding: 15px;
        border-radius: 25px;
    }

    .sleeper-floor {
        padding: 0;
        gap: 8px;
    }

    .sleeper-bed {
        min-height: 85px;
    }

    .seat-row {
        grid-template-columns:
            1fr 1fr 18px 1fr 1fr;
        gap: 5px;
    }

    /*
       Hàng 41 - 45 vẫn giữ 5 ghế.
       Thu nhỏ khoảng cách trên màn hình nhỏ.
    */

    .last-seat-row {
        grid-template-columns:
            repeat(5, 1fr);

        gap: 5px;
    }

    .normal-seat {
        height: 62px;
        border-radius: 9px;
    }

    .seat-icon {
        font-size: 18px;
    }

    .booking-bar {
        bottom: 10px;
        width: calc(100% - 20px);
        padding: 14px;
    }

    .booking-info {
        width: 100%;
        justify-content: space-between;
        margin: 0;
    }

}

</style>


<script>

    const tripId = @((trip?.Id ?? 0));

    const ticketPrice =
        @price.ToString(
            System.Globalization.CultureInfo.InvariantCulture
        );


    const selectedSeatIds = new Set();

    const selectedSeatNumbers = new Map();


    const seatButtons =
        document.querySelectorAll(
            ".normal-seat, .sleeper-bed"
        );


    const selectedSeatsElement =
        document.getElementById(
            "selectedSeats"
        );


    const selectedCountElement =
        document.getElementById(
            "selectedCount"
        );


    const totalPriceElement =
        document.getElementById(
            "totalPrice"
        );


    const continueButton =
        document.getElementById(
            "continueButton"
        );


    /*
     * CLICK GHẾ / GIƯỜNG
     */

    seatButtons.forEach(button => {

        button.addEventListener(
            "click",
            function () {

                if (this.disabled) {
                    return;
                }


                const seatId =
                    Number(
                        this.dataset.seatId
                    );


                const seatNumber =
                    this.dataset.seatNumber;


                /*
                 * Nếu đã chọn
                 * -> bỏ chọn
                 */

                if (
                    selectedSeatIds.has(
                        seatId
                    )
                ) {

                    selectedSeatIds.delete(
                        seatId
                    );

                    selectedSeatNumbers.delete(
                        seatId
                    );

                    this.classList.remove(
                        "selected"
                    );

                }


                /*
                 * Nếu chưa chọn
                 * -> chọn
                 */

                else {

                    selectedSeatIds.add(
                        seatId
                    );

                    selectedSeatNumbers.set(
                        seatId,
                        seatNumber
                    );

                    this.classList.add(
                        "selected"
                    );

                }


                updateBookingSummary();

            }

        );

    });


    /*
     * CẬP NHẬT THÔNG TIN
     */

    function updateBookingSummary() {

        const selectedNumbers =
            Array.from(
                selectedSeatNumbers.values()
            )
            .sort(
                (a, b) =>
                    a.localeCompare(
                        b,
                        undefined,
                        {
                            numeric: true
                        }
                    )
            );


        /*
         * Danh sách ghế / giường
         */

        if (
            selectedNumbers.length === 0
        ) {

            selectedSeatsElement.textContent =
                "Chưa chọn ghế / giường";

        }

        else {

            selectedSeatsElement.textContent =
                selectedNumbers.join(", ");

        }


        /*
         * Số lượng
         */

        selectedCountElement.textContent =
            selectedNumbers.length;


        /*
         * Tổng tiền
         */

        const total =
            selectedNumbers.length *
            ticketPrice;


        totalPriceElement.textContent =
            total.toLocaleString("vi-VN") +
            " đ";


        /*
         * Enable / Disable button
         */

        continueButton.disabled =
            selectedNumbers.length === 0;

    }


    /*
     * TIẾP TỤC ĐẶT VÉ
     */

    continueButton.addEventListener(
        "click",
        function () {

            if (
                selectedSeatIds.size === 0
            ) {

                alert(
                    "Vui lòng chọn ít nhất một ghế hoặc giường."
                );

                return;
            }


            /*
             * Tạo URL:
             *
             * /Bookings/Create
             * ?tripId=1
             * &seatIds=2
             * &seatIds=3
             */

            const params =
                new URLSearchParams();


            params.append(
                "tripId",
                tripId
            );


            selectedSeatIds.forEach(
                id => {

                    params.append(
                        "seatIds",
                        id
                    );

                }
            );


            window.location.href =
                "/Bookings/Create?" +
                params.toString();

        }
    );


    /*
     * KHỞI TẠO
     */

    updateBookingSummary();

</script>