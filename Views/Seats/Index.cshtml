@model List<GoBus.Models.Seat>

@{
    ViewData["Title"] = "Chọn chỗ";

    var trip = ViewBag.Trip as GoBus.Models.Trip;

    var bus = trip?.Bus;

    bool isSleeper =
        ViewBag.IsSleeper == true;

    string vehicleIcon =
        isSleeper ? "🛏️" : "💺";

    string vehicleTitle =
        isSleeper
            ? "XE GIƯỜNG NẰM"
            : "XE GHẾ NGỒI";

    string pageTitle =
        isSleeper
            ? "Chọn giường"
            : "Chọn ghế";

    string layoutTitle =
        isSleeper
            ? "SƠ ĐỒ 24 GIƯỜNG"
            : "SƠ ĐỒ 45 GHẾ";

    int totalPlaces =
        isSleeper ? 24 : 45;

    string departure =
        trip?.Route?.Departure ?? "Chưa xác định";

    string destination =
        trip?.Route?.Destination ?? "Chưa xác định";

    string companyName =
        trip?.BusCompany?.Name ?? "GoBus";

    string busType =
        isSleeper
            ? "Giường nằm 24 chỗ"
            : "Ghế ngồi 45 chỗ";

    string departureTime =
        trip?.DepartureTime.ToString("HH:mm")
        ?? "--:--";

    string departureDate =
        trip?.DepartureTime.ToString("dd/MM/yyyy")
        ?? "--/--/----";

    decimal price =
        trip?.Price ?? 0;

    int availablePlaces =
        Model.Count(s => !s.IsBooked);
}

<div class="seat-page">

    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <div class="top-section">

        <div>

            <div class="vehicle-badge">
                @vehicleIcon @vehicleTitle
            </div>

            <h1>
                @pageTitle
            </h1>

            <div class="route">

                <span>
                    @departure
                </span>

                <span class="arrow">
                    →
                </span>

                <span>
                    @destination
                </span>

            </div>

        </div>

        <div class="price-box">

            <div class="price-label">
                Giá vé
            </div>

            <div class="price">
                @price.ToString("N0") đ
            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- THÔNG TIN CHUYẾN -->
    <!-- ================================================= -->

    <div class="trip-info">

        <div class="trip-info-item">

            <div class="info-icon">
                🏢
            </div>

            <div>

                <div class="label">
                    Nhà xe
                </div>

                <strong>
                    @companyName
                </strong>

            </div>

        </div>


        <div class="trip-info-item">

            <div class="info-icon">
                @vehicleIcon
            </div>

            <div>

                <div class="label">
                    Loại xe
                </div>

                <strong>
                    @busType
                </strong>

            </div>

        </div>


        <div class="trip-info-item">

            <div class="info-icon">
                🕘
            </div>

            <div>

                <div class="label">
                    Khởi hành
                </div>

                <strong>
                    @departureTime - @departureDate
                </strong>

            </div>

        </div>


        <div class="trip-info-item">

            <div class="info-icon">
                @vehicleIcon
            </div>

            <div>

                <div class="label">
                    Còn lại
                </div>

                <strong>
                    @availablePlaces /
                    @totalPlaces
                    @(isSleeper ? "giường" : "ghế")
                </strong>

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- LEGEND -->
    <!-- ================================================= -->

    <div class="legend">

        <div class="legend-item">

            <span class="legend-box available"></span>

            <span>Trống</span>

        </div>

        <div class="legend-item">

            <span class="legend-box selected"></span>

            <span>Đang chọn</span>

        </div>

        <div class="legend-item">

            <span class="legend-box booked"></span>

            <span>Đã đặt</span>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- LAYOUT -->
    <!-- ================================================= -->

    <div class="layout-wrapper">

        <div class="bus-layout">

            <!-- ================================================= -->
            <!-- DRIVER -->
            <!-- ================================================= -->

            <div class="front">

                <div class="driver">

                    <span class="steering">
                        ◉
                    </span>

                    <span>
                        Tài xế
                    </span>

                </div>

                <div class="front-title">
                    ĐẦU XE
                </div>

            </div>


            <!-- ================================================= -->
            <!-- TITLE -->
            <!-- ================================================= -->

            <div class="layout-title">

                @vehicleIcon
                @layoutTitle

            </div>


            @if (isSleeper)
            {
                <!-- ================================================= -->
                <!-- GIƯỜNG NẰM
                     24 GIƯỜNG
                     A01-A12
                     B01-B12
                -->
                <!-- ================================================= -->

                <div class="sleeper-layout">

                    <!-- TẦNG DƯỚI -->

                    <div class="floor">

                        <div class="floor-title">

                            🛏️ TẦNG DƯỚI

                        </div>

                        <div class="bed-grid">

                            @for (int i = 1; i <= 12; i++)
                            {
                                var seatNumber =
                                    $"A{i:00}";

                                var seat =
                                    Model.FirstOrDefault(
                                        s => s.SeatNumber == seatNumber
                                    );

                                if (seat != null)
                                {
                                    <button type="button"
                                            class="place sleeper-place @(seat.IsBooked ? "booked" : "")"
                                            data-seat-id="@seat.Id"
                                            data-seat-number="@seat.SeatNumber"
                                            data-booked="@seat.IsBooked.ToString().ToLower()"
                                            @(seat.IsBooked ? "disabled" : null)>

                                        <span class="bed-icon">
                                            🛏️
                                        </span>

                                        <span>
                                            @seat.SeatNumber
                                        </span>

                                    </button>
                                }
                            }

                        </div>

                    </div>


                    <!-- TẦNG TRÊN -->

                    <div class="floor">

                        <div class="floor-title">

                            🛏️ TẦNG TRÊN

                        </div>

                        <div class="bed-grid">

                            @for (int i = 1; i <= 12; i++)
                            {
                                var seatNumber =
                                    $"B{i:00}";

                                var seat =
                                    Model.FirstOrDefault(
                                        s => s.SeatNumber == seatNumber
                                    );

                                if (seat != null)
                                {
                                    <button type="button"
                                            class="place sleeper-place @(seat.IsBooked ? "booked" : "")"
                                            data-seat-id="@seat.Id"
                                            data-seat-number="@seat.SeatNumber"
                                            data-booked="@seat.IsBooked.ToString().ToLower()"
                                            @(seat.IsBooked ? "disabled" : null)>

                                        <span class="bed-icon">
                                            🛏️
                                        </span>

                                        <span>
                                            @seat.SeatNumber
                                        </span>

                                    </button>
                                }
                            }

                        </div>

                    </div>

                </div>
            }
            else
            {
                <!-- ================================================= -->
                <!-- GHẾ NGỒI 45 CHỖ -->
                <!-- ================================================= -->

                <div class="seat45-layout">

                    @for (int row = 0; row < 12; row++)
                    {
                        int seat1 = row * 4 + 1;
                        int seat2 = row * 4 + 2;
                        int seat3 = row * 4 + 3;
                        int seat4 = row * 4 + 4;

                        <div class="seat-row">

                            <!-- BÊN TRÁI -->

                            @if (seat1 <= 45)
                            {
                                var seatNumber =
                                    seat1.ToString("00");

                                var seat =
                                    Model.FirstOrDefault(
                                        s => s.SeatNumber == seatNumber
                                    );

                                if (seat != null)
                                {
                                    <button type="button"
                                            class="place seat-place @(seat.IsBooked ? "booked" : "")"
                                            data-seat-id="@seat.Id"
                                            data-seat-number="@seat.SeatNumber"
                                            data-booked="@seat.IsBooked.ToString().ToLower()"
                                            @(seat.IsBooked ? "disabled" : null)>

                                        💺 @seat.SeatNumber

                                    </button>
                                }
                            }


                            @if (seat2 <= 45)
                            {
                                var seatNumber =
                                    seat2.ToString("00");

                                var seat =
                                    Model.FirstOrDefault(
                                        s => s.SeatNumber == seatNumber
                                    );

                                if (seat != null)
                                {
                                    <button type="button"
                                            class="place seat-place @(seat.IsBooked ? "booked" : "")"
                                            data-seat-id="@seat.Id"
                                            data-seat-number="@seat.SeatNumber"
                                            data-booked="@seat.IsBooked.ToString().ToLower()"
                                            @(seat.IsBooked ? "disabled" : null)>

                                        💺 @seat.SeatNumber

                                    </button>
                                }
                            }


                            <!-- LỐI ĐI -->

                            <div class="aisle"></div>


                            <!-- BÊN PHẢI -->

                            @if (seat3 <= 45)
                            {
                                var seatNumber =
                                    seat3.ToString("00");

                                var seat =
                                    Model.FirstOrDefault(
                                        s => s.SeatNumber == seatNumber
                                    );

                                if (seat != null)
                                {
                                    <button type="button"
                                            class="place seat-place @(seat.IsBooked ? "booked" : "")"
                                            data-seat-id="@seat.Id"
                                            data-seat-number="@seat.SeatNumber"
                                            data-booked="@seat.IsBooked.ToString().ToLower()"
                                            @(seat.IsBooked ? "disabled" : null)>

                                        💺 @seat.SeatNumber

                                    </button>
                                }
                            }


                            @if (seat4 <= 45)
                            {
                                var seatNumber =
                                    seat4.ToString("00");

                                var seat =
                                    Model.FirstOrDefault(
                                        s => s.SeatNumber == seatNumber
                                    );

                                if (seat != null)
                                {
                                    <button type="button"
                                            class="place seat-place @(seat.IsBooked ? "booked" : "")"
                                            data-seat-id="@seat.Id"
                                            data-seat-number="@seat.SeatNumber"
                                            data-booked="@seat.IsBooked.ToString().ToLower()"
                                            @(seat.IsBooked ? "disabled" : null)>

                                        💺 @seat.SeatNumber

                                    </button>
                                }
                            }

                        </div>
                    }

                </div>
            }


            <!-- ================================================= -->
            <!-- BACK -->
            <!-- ================================================= -->

            <div class="back">

                CUỐI XE

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- SELECTION SUMMARY -->
    <!-- ================================================= -->

    <div class="selection-card">

        <div>

            <div class="selection-label">

                @(isSleeper
                    ? "Giường đã chọn"
                    : "Ghế đã chọn")

            </div>

            <div id="selectedPlaces"
                 class="selected-places">

                Chưa chọn

            </div>

        </div>


        <div class="selection-right">

            <div class="selection-count">

                <span id="selectedCount">
                    0
                </span>

                @(isSleeper ? "giường" : "ghế")

            </div>

            <div class="total-price">

                <span>
                    Tổng:
                </span>

                <strong id="totalPrice">
                    0 đ
                </strong>

            </div>

            <button type="button"
                    id="continueButton"
                    class="continue-button"
                    disabled>

                Tiếp tục

            </button>

        </div>

    </div>

</div>


<!-- ===================================================== -->
<!-- JAVASCRIPT -->
<!-- ===================================================== -->

<script>

    const pricePerPlace =
        @price.ToString(
            System.Globalization.CultureInfo.InvariantCulture
        );

    const selectedSeats = new Map();

    const places =
        document.querySelectorAll(".place:not(.booked)");

    const selectedPlacesElement =
        document.getElementById("selectedPlaces");

    const selectedCountElement =
        document.getElementById("selectedCount");

    const totalPriceElement =
        document.getElementById("totalPrice");

    const continueButton =
        document.getElementById("continueButton");


    // =====================================================
    // CHỌN / BỎ CHỌN
    // =====================================================

    places.forEach(place => {

        place.addEventListener("click", function () {

            const seatId =
                this.dataset.seatId;

            const seatNumber =
                this.dataset.seatNumber;


            // ---------------------------------------------
            // BỎ CHỌN
            // ---------------------------------------------

            if (selectedSeats.has(seatId)) {

                selectedSeats.delete(seatId);

                this.classList.remove("selected");

            }

            // ---------------------------------------------
            // CHỌN
            // ---------------------------------------------

            else {

                selectedSeats.set(
                    seatId,
                    seatNumber
                );

                this.classList.add("selected");

            }

            updateSummary();

        });

    });


    // =====================================================
    // UPDATE SUMMARY
    // =====================================================

    function updateSummary() {

        const selected =
            Array.from(
                selectedSeats.values()
            );


        const count =
            selected.length;


        // ---------------------------------------------
        // DANH SÁCH CHỖ
        // ---------------------------------------------

        if (count === 0) {

            selectedPlacesElement.innerHTML =
                "Chưa chọn";

        }
        else {

            selectedPlacesElement.innerHTML =
                selected
                    .map(place =>
                        `<span class="selected-tag">
                            ${place}
                        </span>`
                    )
                    .join("");

        }


        // ---------------------------------------------
        // SỐ LƯỢNG
        // ---------------------------------------------

        selectedCountElement.textContent =
            count;


        // ---------------------------------------------
        // TỔNG TIỀN
        // ---------------------------------------------

        const total =
            count * pricePerPlace;

        totalPriceElement.textContent =
            total.toLocaleString("vi-VN") + " đ";


        // ---------------------------------------------
        // BUTTON
        // ---------------------------------------------

        continueButton.disabled =
            count === 0;

    }


    // =====================================================
    // CONTINUE
    // =====================================================

    continueButton.addEventListener(
        "click",
        function () {

            if (selectedSeats.size === 0) {

                return;

            }

            const seatIds =
                Array.from(
                    selectedSeats.keys()
                );


            const params =
                new URLSearchParams();

            params.append(
                "tripId",
                "@trip?.Id"
            );


            seatIds.forEach(id => {

                params.append(
                    "seatIds",
                    id
                );

            });


            window.location.href =
                "/Bookings/Create?" +
                params.toString();

        }
    );

</script>


