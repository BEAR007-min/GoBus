@{
    ViewData["Title"] = "Thống kê";

    var totalCustomers = (int)ViewBag.TotalCustomers;
    var totalUsers = (int)ViewBag.TotalUsers;

    var totalBusCompanies = (int)ViewBag.TotalBusCompanies;
    var totalBuses = (int)ViewBag.TotalBuses;
    var totalRoutes = (int)ViewBag.TotalRoutes;
    var totalTrips = (int)ViewBag.TotalTrips;

    var totalBookings = (int)ViewBag.TotalBookings;
    var confirmedBookings = (int)ViewBag.ConfirmedBookings;
    var cancelledBookings = (int)ViewBag.CancelledBookings;

    var totalRevenue = (decimal)ViewBag.TotalRevenue;
    var confirmedRevenue = (decimal)ViewBag.ConfirmedRevenue;
    var cancelledRevenue = (decimal)ViewBag.CancelledRevenue;

    var todayBookings = (int)ViewBag.TodayBookings;
    var todayRevenue = (decimal)ViewBag.TodayRevenue;
    var todayTrips = (int)ViewBag.TodayTrips;

    var totalSeats = (int)ViewBag.TotalSeats;
    var bookedSeats = (int)ViewBag.BookedSeats;
    var availableSeats = (int)ViewBag.AvailableSeats;

    var bookingRate = totalBookings > 0
        ? (double)confirmedBookings / totalBookings * 100
        : 0;

    var seatRate = totalSeats > 0
        ? (double)bookedSeats / totalSeats * 100
        : 0;

    var topBusCompanies = ViewBag.TopBusCompanies as IEnumerable<dynamic>;
    var topRoutes = ViewBag.TopRoutes as IEnumerable<dynamic>;
    var last7Days = ViewBag.Last7Days as IEnumerable<dynamic>;
}

<style>
    .statistics-page {
        padding: 30px 0 60px;
    }

    .page-title {
        font-weight: 700;
    }

    .stat-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
        height: 100%;
    }

    .stat-icon {
        width: 55px;
        height: 55px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .stat-number {
        font-size: 28px;
        font-weight: 700;
        margin-top: 10px;
    }

    .section-card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.07);
        height: 100%;
    }

    .section-title {
        font-weight: 700;
    }

    .progress {
        height: 10px;
        border-radius: 10px;
    }

    .table td {
        vertical-align: middle;
    }

    .ranking-number {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        background: #f1f3f5;
    }

    .revenue {
        font-weight: 700;
    }

    .chart-container {
        position: relative;
        height: 300px;
    }

    @@media (max-width: 768px) {
        .statistics-page {
            padding: 20px 10px 40px;
        }

        .stat-number {
            font-size: 23px;
        }
    }
</style>

<div class="container-fluid statistics-page">

    <!-- HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="page-title mb-1">
                📊 Thống kê hệ thống
            </h2>

            <p class="text-muted mb-0">
                Tổng quan hoạt động và doanh thu của GoBus.
            </p>

        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Dashboard
        </a>

    </div>


    <!-- ========================= -->
    <!-- TỔNG QUAN -->
    <!-- ========================= -->

    <div class="row g-4 mb-4">

        <!-- KHÁCH HÀNG -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-primary-subtle">
                        👥
                    </div>

                    <div class="text-muted mt-3">
                        Khách hàng
                    </div>

                    <div class="stat-number text-primary">
                        @totalCustomers
                    </div>

                </div>

            </div>

        </div>


        <!-- NHÀ XE -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-success-subtle">
                        🏢
                    </div>

                    <div class="text-muted mt-3">
                        Nhà xe
                    </div>

                    <div class="stat-number text-success">
                        @totalBusCompanies
                    </div>

                </div>

            </div>

        </div>


        <!-- TUYẾN -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-warning-subtle">
                        🛣️
                    </div>

                    <div class="text-muted mt-3">
                        Tuyến xe
                    </div>

                    <div class="stat-number text-warning">
                        @totalRoutes
                    </div>

                </div>

            </div>

        </div>


        <!-- CHUYẾN -->

        <div class="col-xl-3 col-md-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-info-subtle">
                        🚍
                    </div>

                    <div class="text-muted mt-3">
                        Chuyến xe
                    </div>

                    <div class="stat-number text-info">
                        @totalTrips
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================= -->
    <!-- DOANH THU + VÉ -->
    <!-- ========================= -->

    <div class="row g-4 mb-4">

        <!-- DOANH THU -->

        <div class="col-lg-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-success-subtle">
                        💰
                    </div>

                    <div class="text-muted mt-3">
                        Doanh thu xác nhận
                    </div>

                    <div class="stat-number text-success">
                        @confirmedRevenue.ToString("N0") ₫
                    </div>

                    <div class="small text-muted mt-2">
                        Tổng doanh thu:
                        @totalRevenue.ToString("N0") ₫
                    </div>

                </div>

            </div>

        </div>


        <!-- VÉ -->

        <div class="col-lg-6">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="stat-icon bg-primary-subtle">
                        🎫
                    </div>

                    <div class="text-muted mt-3">
                        Vé đã xác nhận
                    </div>

                    <div class="stat-number text-primary">
                        @confirmedBookings
                    </div>

                    <div class="small text-muted mt-2">
                        Tổng:
                        @totalBookings
                        vé
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================= -->
    <!-- HÔM NAY -->
    <!-- ========================= -->

    <div class="row g-4 mb-4">

        <div class="col-md-4">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="text-muted">
                        📅 Vé đặt hôm nay
                    </div>

                    <div class="stat-number">
                        @todayBookings
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="text-muted">
                        💰 Doanh thu hôm nay
                    </div>

                    <div class="stat-number text-success">
                        @todayRevenue.ToString("N0") ₫
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card stat-card">

                <div class="card-body">

                    <div class="text-muted">
                        🚍 Chuyến hôm nay
                    </div>

                    <div class="stat-number text-info">
                        @todayTrips
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================= -->
    <!-- TRẠNG THÁI VÉ + GHẾ -->
    <!-- ========================= -->

    <div class="row g-4 mb-4">

        <div class="col-lg-6">

            <div class="card section-card">

                <div class="card-body">

                    <h5 class="section-title">
                        🎫 Trạng thái vé
                    </h5>

                    <div class="mb-3">

                        <div class="d-flex justify-content-between">

                            <span>
                                Đã xác nhận
                            </span>

                            <strong>
                                @confirmedBookings
                            </strong>

                        </div>

                        <div class="progress mt-2">

                            <div class="progress-bar bg-success"
                                 style="width:@bookingRate%">
                            </div>

                        </div>

                    </div>


                    <div class="mb-3">

                        <div class="d-flex justify-content-between">

                            <span>
                                Đã hủy
                            </span>

                            <strong>
                                @cancelledBookings
                            </strong>

                        </div>

                        <div class="progress mt-2">

                            <div class="progress-bar bg-danger"
                                 style="width:@(
                                     totalBookings > 0
                                         ? (double)cancelledBookings /
                                           totalBookings * 100
                                         : 0
                                 )%">
                            </div>

                        </div>

                    </div>


                    <div class="mt-4">

                        <div class="d-flex justify-content-between">

                            <span>
                                Tổng số vé
                            </span>

                            <strong>
                                @totalBookings
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-lg-6">

            <div class="card section-card">

                <div class="card-body">

                    <h5 class="section-title">
                        💺 Tình trạng ghế / giường
                    </h5>

                    <div class="mb-3">

                        <div class="d-flex justify-content-between">

                            <span>
                                Đã đặt
                            </span>

                            <strong>
                                @bookedSeats
                            </strong>

                        </div>

                        <div class="progress mt-2">

                            <div class="progress-bar bg-danger"
                                 style="width:@seatRate%">
                            </div>

                        </div>

                    </div>


                    <div class="mb-3">

                        <div class="d-flex justify-content-between">

                            <span>
                                Còn trống
                            </span>

                            <strong>
                                @availableSeats
                            </strong>

                        </div>

                        <div class="progress mt-2">

                            <div class="progress-bar bg-success"
                                 style="width:@(
                                     totalSeats > 0
                                         ? (double)availableSeats /
                                           totalSeats * 100
                                         : 0
                                 )%">
                            </div>

                        </div>

                    </div>


                    <div class="mt-4">

                        <div class="d-flex justify-content-between">

                            <span>
                                Tổng ghế / giường
                            </span>

                            <strong>
                                @totalSeats
                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================= -->
    <!-- TOP NHÀ XE + TOP TUYẾN -->
    <!-- ========================= -->

    <div class="row g-4 mb-4">

        <!-- TOP NHÀ XE -->

        <div class="col-lg-6">

            <div class="card section-card">

                <div class="card-body">

                    <h5 class="section-title mb-4">
                        🏆 Top nhà xe
                    </h5>

                    @if (topBusCompanies != null &&
                         topBusCompanies.Any())
                    {
                        int rank = 1;

                        foreach (var company in topBusCompanies)
                        {
                            <div class="d-flex align-items-center mb-3">

                                <span class="ranking-number">
                                    @rank
                                </span>

                                <div class="ms-3 flex-grow-1">

                                    <div class="fw-semibold">
                                        @company.Name
                                    </div>

                                    <div class="small text-muted">
                                        @company.BookingCount vé
                                    </div>

                                </div>

                                <div class="revenue text-success">

                                    @company.Revenue.ToString("N0")
                                    ₫

                                </div>

                            </div>

                            rank++;
                        }
                    }
                    else
                    {
                        <div class="text-muted text-center py-4">
                            Chưa có dữ liệu.
                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- TOP TUYẾN -->

        <div class="col-lg-6">

            <div class="card section-card">

                <div class="card-body">

                    <h5 class="section-title mb-4">
                        🛣️ Top tuyến được đặt nhiều
                    </h5>

                    @if (topRoutes != null &&
                         topRoutes.Any())
                    {
                        int rank = 1;

                        foreach (var route in topRoutes)
                        {
                            <div class="d-flex align-items-center mb-3">

                                <span class="ranking-number">
                                    @rank
                                </span>

                                <div class="ms-3 flex-grow-1">

                                    <div class="fw-semibold">
                                        @route.Route
                                    </div>

                                    <div class="small text-muted">
                                        @route.BookingCount vé
                                    </div>

                                </div>

                                <div class="revenue text-success">

                                    @route.Revenue.ToString("N0")
                                    ₫

                                </div>

                            </div>

                            rank++;
                        }
                    }
                    else
                    {
                        <div class="text-muted text-center py-4">
                            Chưa có dữ liệu.
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- ========================= -->
    <!-- 7 NGÀY GẦN NHẤT -->
    <!-- ========================= -->

    <div class="card section-card mb-4">

        <div class="card-body">

            <h5 class="section-title mb-4">
                📈 Hoạt động 7 ngày gần nhất
            </h5>

            @if (last7Days != null &&
                 last7Days.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Ngày
                                </th>

                                <th>
                                    Số vé
                                </th>

                                <th>
                                    Doanh thu
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var day in last7Days)
                            {
                                <tr>

                                    <td>
                                        @day.Date
                                    </td>

                                    <td>
                                        <strong>
                                            @day.BookingCount
                                        </strong>
                                    </td>

                                    <td class="text-success fw-semibold">
                                        @day.Revenue.ToString("N0") ₫
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    Chưa có dữ liệu.
                </div>
            }

        </div>

    </div>


    <!-- ========================= -->
    <!-- THỐNG KÊ HỆ THỐNG -->
    <!-- ========================= -->

    <div class="card section-card">

        <div class="card-body">

            <h5 class="section-title mb-4">
                ⚙️ Thống kê hệ thống
            </h5>

            <div class="row g-4">

                <div class="col-md-4">

                    <div class="d-flex justify-content-between">

                        <span>
                            👤 Tài khoản
                        </span>

                        <strong>
                            @totalUsers
                        </strong>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="d-flex justify-content-between">

                        <span>
                            🚌 Xe
                        </span>

                        <strong>
                            @totalBuses
                        </strong>

                    </div>

                </div>


                <div class="col-md-4">

                    <div class="d-flex justify-content-between">

                        <span>
                            🛣️ Tuyến
                        </span>

                        <strong>
                            @totalRoutes
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="mt-4">

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Quay lại Dashboard
        </a>

    </div>

</div>