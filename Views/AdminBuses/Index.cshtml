@model IEnumerable<GoBus.Models.Bus>

@{
    ViewData["Title"] = "Quản lý xe";

    var busCompanies =
        ViewBag.BusCompanies as IEnumerable<GoBus.Models.BusCompany>
        ?? Enumerable.Empty<GoBus.Models.BusCompany>();
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">🚌 Quản lý xe</h2>
            <p class="text-muted mb-0">
                Quản lý danh sách xe của các nhà xe.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            ➕ Thêm xe
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3">

                <div class="col-md-5">
                    <label class="form-label">
                        Tìm kiếm
                    </label>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Biển số hoặc loại xe..." />
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        Nhà xe
                    </label>

                    <select name="busCompanyId"
                            class="form-select">

                        <option value="">
                            -- Tất cả nhà xe --
                        </option>

                        @foreach (var company in busCompanies)
                        {
                            <option value="@company.Id"
                                    selected="@(ViewBag.BusCompanyId == company.Id)">
                                @company.Name
                            </option>
                        }

                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        🔍 Tìm kiếm
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Đặt lại
                    </a>

                </div>

            </form>

        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Biển số</th>
                            <th>Nhà xe</th>
                            <th>Loại xe</th>
                            <th>Số chỗ</th>
                            <th>Layout</th>
                            <th class="text-end">
                                Thao tác
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-5">
                                Không tìm thấy xe.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = 1;

                        foreach (var bus in Model)
                        {
                            bool sleeper =
                                bus.LayoutType == "Sleeper24";

                            <tr>

                                <td>
                                    @index
                                </td>

                                <td>
                                    <strong>
                                        @bus.LicensePlate
                                    </strong>
                                </td>

                                <td>
                                    @bus.BusCompany?.Name
                                </td>

                                <td>
                                    @(sleeper
                                        ? "🛏️ Giường nằm"
                                        : "💺 Ghế ngồi")
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        @bus.TotalSeats chỗ
                                    </span>
                                </td>

                                <td>
                                    <code>
                                        @bus.LayoutType
                                    </code>
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@bus.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Xem
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@bus.Id"
                                       class="btn btn-sm btn-outline-warning">
                                        Sửa
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@bus.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa xe này?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Xóa
                                        </button>

                                    </form>

                                </td>

                            </tr>

                            index++;
                        }
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>