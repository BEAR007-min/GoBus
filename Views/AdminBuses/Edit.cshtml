@model GoBus.Models.Bus

@{
    ViewData["Title"] = "Thêm xe";
    var busCompanies =
        ViewBag.BusCompanies as IEnumerable<GoBus.Models.BusCompany>
        ?? Enumerable.Empty<GoBus.Models.BusCompany>();
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h2 class="fw-bold">➕ Thêm xe</h2>
        <p class="text-muted">
            Thêm một xe mới vào hệ thống GoBus.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row g-4">

                    <div class="col-md-6">

                        <label asp-for="BusCompanyId"
                               class="form-label fw-semibold">
                            Nhà xe
                        </label>

                        <select asp-for="BusCompanyId"
                                class="form-select">

                            <option value="">
                                -- Chọn nhà xe --
                            </option>

                            @foreach (var company in busCompanies)
                            {
                                <option value="@company.Id">
                                    @company.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="BusCompanyId"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="LicensePlate"
                               class="form-label fw-semibold">
                            Biển số xe
                        </label>

                        <input asp-for="LicensePlate"
                               class="form-control"
                               placeholder="Ví dụ: 29A-123.45" />

                        <span asp-validation-for="LicensePlate"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Loại xe
                        </label>

                        <select asp-for="LayoutType"
                                class="form-select"
                                id="layoutType">

                            <option value="Seat45">
                                💺 Xe ghế ngồi 45 chỗ
                            </option>

                            <option value="Sleeper24">
                                🛏️ Xe giường nằm 24 chỗ
                            </option>

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Số chỗ
                        </label>

                        <input id="totalSeats"
                               class="form-control"
                               value="45"
                               readonly />

                        <small class="text-muted">
                            Số chỗ được tự động xác định theo loại xe.
                        </small>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        💾 Lưu xe
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        ← Quay lại
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        const layoutType =
            document.getElementById("layoutType");

        const totalSeats =
            document.getElementById("totalSeats");

        function updateTotalSeats() {

            if (layoutType.value === "Sleeper24") {
                totalSeats.value = "24";
            }
            else {
                totalSeats.value = "45";
            }
        }

        layoutType.addEventListener(
            "change",
            updateTotalSeats
        );

        updateTotalSeats();
    </script>
}