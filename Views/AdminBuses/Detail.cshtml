@model GoBus.Models.Bus

@{
    ViewData["Title"] = "Chi tiết xe";

    bool isSleeper =
        Model.LayoutType == "Sleeper24";

    var trips =
        Model.Trips ?? new List<GoBus.Models.Trip>();
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                @if (isSleeper)
                {
                    <span>🛏️</span>
                }
                else
                {
                    <span>💺</span>
                }

                Chi tiết xe
            </h2>

            <p class="text-muted mb-0">
                Thông tin chi tiết của phương tiện.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                ✏️ Chỉnh sửa
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                ← Quay lại
            </a>

        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-5">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h5 class="fw-bold mb-4">
                        Thông tin phương tiện
                    </h5>

                    <div class="mb-3">
                        <small class="text-muted">
                            Biển số
                        </small>

                        <div class="fs-5 fw-bold">
                            @Model.LicensePlate
                        </div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">
                            Nhà xe
                        </small>

                        <div>
                            @Model.BusCompany?.Name
                        </div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">
                            Loại xe
                        </small>

                        <div>
                            @if (isSleeper)
                            {
                                <span class="badge bg-info text-dark">
                                    🛏️ Giường nằm
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-primary">
                                    💺 Ghế ngồi
                                </span>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted">
                            Số chỗ
                        </small>

                        <div class="fs-4 fw-bold">
                            @Model.TotalSeats chỗ
                        </div>
                    </div>

                    <div>
                        <small class="text-muted">
                            Layout
                        </small>

                        <div>
                            <code>
                                @Model.LayoutType
                            </code>
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-3">

                        <h5 class="fw-bold mb-0">
                            🚌 Các chuyến sử dụng xe
                        </h5>

                        <span class="badge bg-secondary">
                            @trips.Count chuyến
                        </span>

                    </div>

                    @if (!trips.Any())
                    {
                        <div class="text-center text-muted py-5">
                            Xe chưa được sử dụng trong chuyến nào.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover">

                                <thead>
                                    <tr>
                                        <th>Chuyến</th>
                                        <th>Tuyến</th>
                                        <th>Khởi hành</th>
                                        <th>Giá</th>
                                    </tr>
                                </thead>

                                <tbody>

                                @foreach (var trip in trips
                                    .OrderByDescending(t => t.DepartureTime)
                                    .Take(20))
                                {
                                    <tr>

                                        <td>
                                            #@trip.Id
                                        </td>

                                        <td>
                                            @trip.Route?.Departure
                                            →
                                            @trip.Route?.Destination
                                        </td>

                                        <td>
                                            @trip.DepartureTime.ToString(
                                                "dd/MM/yyyy HH:mm")
                                        </td>

                                        <td>
                                            @trip.Price.ToString(
                                                "#,##0") đ
                                        </td>

                                    </tr>
                                }

                                </tbody>

                            </table>

                        </div>

                        @if (trips.Count > 20)
                        {
                            <div class="text-muted small">
                                Hiển thị 20 chuyến gần nhất.
                            </div>
                        }
                    }

                </div>

            </div>

        </div>

    </div>

</div>