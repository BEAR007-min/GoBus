@model GoBus.Models.Route

@{
    ViewData["Title"] = "Chi tiết tuyến";

    var trips =
        Model.Trips ?? new List<GoBus.Models.Trip>();
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                🛣️ Chi tiết tuyến
            </h2>

            <p class="text-muted mb-0">
                Thông tin tuyến đường và các chuyến đang sử dụng.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                ✏️ Chỉnh sửa
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                ← Quay lại
            </a>

        </div>

    </div>

    <div class="row g-4">

        <div class="col-lg-5">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <h5 class="fw-bold mb-4">
                        Thông tin tuyến
                    </h5>

                    <div class="mb-4">

                        <small class="text-muted">
                            Điểm đi
                        </small>

                        <div class="fs-4 fw-bold">
                            📍 @Model.Departure
                        </div>

                    </div>

                    <div class="text-center mb-4">
                        <span class="fs-3">
                            ↓
                        </span>
                    </div>

                    <div class="mb-4">

                        <small class="text-muted">
                            Điểm đến
                        </small>

                        <div class="fs-4 fw-bold">
                            🏁 @Model.Destination
                        </div>

                    </div>

                    <hr />

                    <div class="row text-center">

                        <div class="col-6">

                            <small class="text-muted">
                                Khoảng cách
                            </small>

                            <div class="fs-5 fw-bold">
                                @Model.Distance.ToString("0.##")
                                km
                            </div>

                        </div>

                        <div class="col-6">

                            <small class="text-muted">
                                Thời gian
                            </small>

                            <div class="fs-5 fw-bold">
                                @Model.EstimatedDuration phút
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-7">

            <div class="card shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-3">

                        <h5 class="fw-bold">
                            🚌 Các chuyến sử dụng tuyến
                        </h5>

                        <span class="badge bg-secondary">
                            @trips.Count chuyến
                        </span>

                    </div>

                    @if (!trips.Any())
                    {
                        <div class="text-center text-muted py-5">
                            Chưa có chuyến xe sử dụng tuyến này.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle">

                                <thead>
                                    <tr>
                                        <th>Chuyến</th>
                                        <th>Nhà xe</th>
                                        <th>Xe</th>
                                        <th>Khởi hành</th>
                                        <th>Giá</th>
                                    </tr>
                                </thead>

                                <tbody>

                                @foreach (var trip in trips
                                    .OrderByDescending(t => t.DepartureTime)
                                    .Take(20))
                                {
                                    <tr>

                                        <td>
                                            #@trip.Id
                                        </td>

                                        <td>
                                            @trip.BusCompany?.Name
                                        </td>

                                        <td>
                                            @trip.Bus?.LicensePlate
                                        </td>

                                        <td>
                                            @trip.DepartureTime.ToString(
                                                "dd/MM/yyyy HH:mm")
                                        </td>

                                        <td>
                                            @trip.Price.ToString(
                                                "#,##0") đ
                                        </td>

                                    </tr>
                                }

                                </tbody>

                            </table>

                        </div>

                        @if (trips.Count > 20)
                        {
                            <small class="text-muted">
                                Chỉ hiển thị 20 chuyến gần nhất.
                            </small>
                        }
                    }

                </div>

            </div>

        </div>

    </div>

</div>