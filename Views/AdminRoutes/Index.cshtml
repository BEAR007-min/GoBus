@model IEnumerable<GoBus.Models.Route>

@{
    ViewData["Title"] = "Quản lý tuyến";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                🛣️ Quản lý tuyến
            </h2>

            <p class="text-muted mb-0">
                Quản lý các tuyến đường của GoBus.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            ➕ Thêm tuyến
        </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get"
                  class="row g-3">

                <div class="col-md-9">

                    <label class="form-label">
                        Tìm kiếm tuyến
                    </label>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="form-control"
                           placeholder="Nhập điểm đi hoặc điểm đến..." />

                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        🔍 Tìm kiếm
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Đặt lại
                    </a>

                </div>

            </form>

        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Điểm đi</th>
                            <th>Điểm đến</th>
                            <th>Khoảng cách</th>
                            <th>Thời gian dự kiến</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center text-muted py-5">
                                Không tìm thấy tuyến đường.
                            </td>
                        </tr>
                    }
                    else
                    {
                        int index = 1;

                        foreach (var route in Model)
                        {
                            <tr>

                                <td>
                                    @index
                                </td>

                                <td>
                                    <strong>
                                        📍 @route.Departure
                                    </strong>
                                </td>

                                <td>
                                    <strong>
                                        🏁 @route.Destination
                                    </strong>
                                </td>

                                <td>
                                    @route.Distance.ToString("0.##") km
                                </td>

                                <td>
                                    @route.EstimatedDuration phút
                                </td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@route.Id"
                                       class="btn btn-sm btn-outline-info">
                                        Xem
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@route.Id"
                                       class="btn btn-sm btn-outline-warning">
                                        Sửa
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@route.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa tuyến này?');">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">
                                            Xóa
                                        </button>

                                    </form>

                                </td>

                            </tr>

                            index++;
                        }
                    }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>